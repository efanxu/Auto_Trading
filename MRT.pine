//@version=6
//@strategy_alert_message {{strategy.order.alert_message}} | fill={{strategy.order.price}}
// This Pine Script® code is subject to the terms of the Mozilla Public License 2.0 at https://mozilla.org/MPL/2.0/
// © Jasxu · TradingView: https://www.tradingview.com/u/Jasxu/
// GitHub: https://github.com/Ye-Yu-Mo
strategy("MR-T Strategy", shorttitle = "MR-T v3", overlay = true, pyramiding = 0, default_qty_type = strategy.percent_of_equity, default_qty_value = 100, commission_type = strategy.commission.percent, commission_value = 0.03, slippage = 0, process_orders_on_close = false, calc_on_order_fills = true, calc_on_every_tick = false, max_labels_count = 500)

// ============================================================================
// Mean Reversion T (MR-T) · Strategy v3.1.0
//
// 推荐周期 / Recommended timeframe : 15 分钟 (15m) —— 脚本内强制校验
//
// 双引擎 / Dual Engine
//   1. Range Reversion   市场适合震荡回归 → 温和 Z 偏离即可观察
//   2. Shock Reversal    市场不一定横盘 → 异常冲击 + 减速/拒绝 + 回归确认
// 共同保护 / Guard        Hard Trend Veto (1H + 15m 斜率与 Efficiency Ratio)
// 生命周期 / Lifecycle    观察 → T买/T空 → T减 → T平
// 异常退出 / Exits        T止损 / 趋势失效 / T超时 / T保本
//
// 定位 / Scope: TradingView strategy,用于 Strategy Tester 回测,不构成投资建议。
// 收盘确认信号 → 下一可成交时点执行;换品种/周期前请重新评估全部参数。
//
// 版本 / Version: v3.1.0 —— Confirmed-close Strategy Tester 回测版本。变更见 CHANGELOG.md。
// ============================================================================


// ============================================================================
// ⑫ 语言与版本 / ⑫ Language & Version
// ============================================================================
// 运行时 UI(面板 / 图表标签 / 报错)随 lang 切换中英文。
// 注意:Pine 的 input 标题/分组、plotshape 的 text 都是编译期 const string,
// 无法用运行时变量切换语言:输入项标签保持中文。策略 alert() 与 order
// alert_message 使用运行时字符串,包含实际事件、方向、模式和成交占位符。

lang = input.string("zh", "语言 / Language", options = ["zh", "en"], group = "⑫ 语言与版本 / Language & Version")

f_tr(simple string zh, simple string en) =>
    lang == "zh" ? zh : en

string SCRIPT_NAME = "MR-T"
string SCRIPT_VERSION = "3.1.0"


// ============================================================================
// ① 交易方向
// ============================================================================

allowLong = input.bool(true, "允许T买", group = "① 交易方向")
allowShort = input.bool(true, "允许T空", group = "① 交易方向")


// ============================================================================
// ② 均值与 Z-score
// ============================================================================

meanLen = input.int(32, "15m 局部均值 EMA", minval = 10, group = "② 均值与Z-score")
zLen = input.int(32, "Z-score 周期", minval = 10, group = "② 均值与Z-score")

rangeEntryZ = input.float(1.65, "Range模式观察 Z", minval = 1.0, step = 0.05, group = "② 均值与Z-score")
shockEntryZ = input.float(2.00, "Shock模式观察 Z", minval = 1.2, step = 0.05, group = "② 均值与Z-score")

rangePartialZ = input.float(0.80, "Range T减目标 Z", minval = 0.10, step = 0.05, group = "② 均值与Z-score")
rangeExitZ = input.float(0.25, "Range T平目标 Z", minval = 0.0, step = 0.05, group = "② 均值与Z-score")

shockPartialZ = input.float(1.00, "Shock T减目标 Z", minval = 0.10, step = 0.05, group = "② 均值与Z-score")
shockExitZ = input.float(0.50, "Shock T平目标 Z", minval = 0.0, step = 0.05, group = "② 均值与Z-score")

stopZ = input.float(3.25, "极端统计失效 Z", minval = 2.2, step = 0.25, group = "② 均值与Z-score")


// ============================================================================
// ③ 1H 市场状态
// ============================================================================

htfTf = input.timeframe("60", "市场状态周期", group = "③ 1H 市场状态")
htfMeanLen = input.int(20, "1H 均值 EMA", minval = 5, group = "③ 1H 市场状态")
htfSlopeLookback = input.int(4, "1H 斜率周期", minval = 1, group = "③ 1H 市场状态")

idealHtfSlope = input.float(0.10, "1H 理想最大斜率 ATR/Bar", minval = 0.01, step = 0.01, group = "③ 1H 市场状态")

htfERLen = input.int(10, "1H Efficiency Ratio 周期", minval = 3, group = "③ 1H 市场状态")
idealHtfER = input.float(0.50, "1H 理想最大 ER", minval = 0.10, maxval = 1.0, step = 0.05, group = "③ 1H 市场状态")


// ============================================================================
// ④ 15m 市场状态
// ============================================================================

localSlopeLookback = input.int(8, "15m 斜率周期", minval = 2, group = "④ 15m 市场状态")
idealLocalSlope = input.float(0.12, "15m 理想最大斜率 ATR/Bar", minval = 0.01, step = 0.01, group = "④ 15m 市场状态")

localERLen = input.int(16, "15m Efficiency Ratio 周期", minval = 3, group = "④ 15m 市场状态")
idealLocalER = input.float(0.60, "15m 理想最大 ER", minval = 0.10, maxval = 1.0, step = 0.05, group = "④ 15m 市场状态")


// ============================================================================
// ⑤ Regime Score
// ============================================================================

rangeMinScore = input.float(50.0, "Range模式最低环境分", minval = 0, maxval = 100, step = 1, group = "⑤ Regime Score")
shockMinScore = input.float(45.0, "Shock模式最低环境分", minval = 0, maxval = 100, step = 1, group = "⑤ Regime Score")

regimeSmoothLen = input.int(3, "环境分平滑周期", minval = 1, maxval = 8, group = "⑤ Regime Score")


// ============================================================================
// ⑥ Hard Trend Veto
// ============================================================================

vetoHtfSlope = input.float(0.18, "1H 趋势禁做斜率", minval = 0.05, step = 0.01, group = "⑥ Hard Trend Veto")
vetoLocalSlope = input.float(0.23, "15m 趋势禁做斜率", minval = 0.05, step = 0.01, group = "⑥ Hard Trend Veto")

vetoHtfER = input.float(0.75, "1H 趋势禁做 ER", minval = 0.50, maxval = 1.0, step = 0.01, group = "⑥ Hard Trend Veto")
vetoLocalER = input.float(0.80, "15m 趋势禁做 ER", minval = 0.50, maxval = 1.0, step = 0.01, group = "⑥ Hard Trend Veto")


// ============================================================================
// ⑦ Shock Engine
// ============================================================================

shockLookback = input.int(2, "Shock 检测 K 数", minval = 1, maxval = 4, group = "⑦ Shock Engine")
minShockATR = input.float(0.80, "最小 Shock 强度 ATR", minval = 0.20, step = 0.05, group = "⑦ Shock Engine")

requireShockDeceleration = input.bool(true, "Shock要求冲击减速", group = "⑦ Shock Engine")
decelerationRatio = input.float(0.85, "Shock减速比例", minval = 0.30, maxval = 1.20, step = 0.05, group = "⑦ Shock Engine")

requireRejection = input.bool(true, "Shock要求拒绝/反向K线", group = "⑦ Shock Engine")

minWickRatio = input.float(0.30, "最低拒绝影线比例", minval = 0.0, maxval = 0.8, step = 0.05, group = "⑦ Shock Engine")


// ============================================================================
// ⑧ Half-Life / Time Stop
// ============================================================================

halfLifeLookback = input.int(80, "Half-Life 样本长度", minval = 30, group = "⑧ Half-Life")

timeStopMultiplier = input.float(3.0, "Time Stop = Half-Life ×", minval = 1.0, step = 0.25, group = "⑧ Half-Life")

minTimeStopBars = input.int(8, "最短 Time Stop", minval = 2, group = "⑧ Half-Life")
maxTimeStopBars = input.int(40, "最长 Time Stop", minval = 8, group = "⑧ Half-Life")
fallbackTimeStopBars = input.int(24, "Half-Life无效时 Time Stop", minval = 4, group = "⑧ Half-Life")


// ============================================================================
// ⑨ Setup / Confirmation
// ============================================================================

rangeSetupBars = input.int(16, "Range Setup 有效 K 数", minval = 2, maxval = 48, group = "⑨ 入场确认")
shockSetupBars = input.int(8, "Shock Setup 有效 K 数", minval = 2, maxval = 24, group = "⑨ 入场确认")

requireCandleConfirm = input.bool(true, "要求K线方向确认", group = "⑨ 入场确认")
requireBandReclaim = input.bool(true, "要求价格重新进入Z区间", group = "⑨ 入场确认")

cooldownBars = input.int(3, "退出后冷却 K 数", minval = 0, maxval = 24, group = "⑨ 入场确认")
trimPct = input.float(50.0, "T减退出仓位 (%)", minval = 1.0, maxval = 99.0, step = 1.0, group = "⑨ 入场确认")


// ============================================================================
// ⑩ 风险控制
// ============================================================================

atrLen = input.int(14, "ATR 周期", minval = 1, group = "⑩ 风险控制")

hardStopATR = input.float(2.50, "ATR 紧急止损", minval = 0.50, step = 0.25, group = "⑩ 风险控制")

stopMode = input.string("Balanced", "止损模式", options = ["Tight", "Balanced", "Loose"], group = "⑩ 风险控制")

balancedWeight = input.float(0.50, "Balanced统计止损权重", minval = 0.0, maxval = 1.0, step = 0.05, group = "⑩ 风险控制")

moveStopToBE = input.bool(true, "T减后启用保本保护", group = "⑩ 风险控制")

// strategy() 只能接受编译期的 commission/slippage 默认值;这两个输入用于
// BE 价格估算,应与 Strategy Tester -> Properties 中的设置保持一致。
commissionBps = input.float(3.0, "Strategy Tester 手续费(bp/边)", minval = 0.0, step = 0.5, group = "⑩ 风险控制")
slippageTicks = input.int(0, "Strategy Tester 滑点(ticks/边)", minval = 0, group = "⑩ 风险控制")


// ============================================================================
// ⑪ 显示
// ============================================================================

showBands = input.bool(true, "显示均值回归区间", group = "⑪ 显示")
showBackground = input.bool(true, "显示做T环境", group = "⑪ 显示")
showSetup = input.bool(true, "显示观察信号", group = "⑪ 显示")
showPanel = input.bool(true, "显示状态面板", group = "⑪ 显示")
showTradeLevels = input.bool(true, "显示本轮目标/风险", group = "⑪ 显示")


// ============================================================================
// 参数检查
// ============================================================================

if shockEntryZ <= rangeEntryZ
    runtime.error("Shock模式 Z 必须高于 Range模式 Z。/ Shock mode Z must be higher than Range mode Z.")

if rangeExitZ >= rangePartialZ
    runtime.error("Range T平目标必须小于 Range T减目标。/ Range exit Z must be below Range partial Z.")

if shockExitZ >= shockPartialZ
    runtime.error("Shock T平目标必须小于 Shock T减目标。/ Shock exit Z must be below Shock partial Z.")

if rangePartialZ >= rangeEntryZ
    runtime.error("Range T减目标必须小于 Range观察 Z。/ Range partial Z must be below Range entry Z.")

if shockPartialZ >= shockEntryZ
    runtime.error("Shock T减目标必须小于 Shock观察 Z。/ Shock partial Z must be below Shock entry Z.")

if stopZ <= shockEntryZ
    runtime.error("Stop Z 必须高于 Shock Entry Z。/ Stop Z must be above Shock entry Z.")


// ============================================================================
// 周期保护
// ============================================================================

chartSeconds = timeframe.in_seconds(timeframe.period)
requiredSeconds = timeframe.in_seconds("15")
htfSeconds = timeframe.in_seconds(htfTf)

if chartSeconds != requiredSeconds
    runtime.error("Mean Reversion T 设计用于15分钟图。/ Designed for the 15-minute chart.")

if htfSeconds <= chartSeconds
    runtime.error("高周期必须高于15分钟,默认使用60分钟。/ Higher timeframe must be above 15m. Default is 60m.")


// ============================================================================
// Helper Functions
// ============================================================================

// Kaufman Efficiency Ratio, 路径用平均单根位移近似。
f_er(int length) =>
    float absMove = math.abs(ta.change(close))
    float avgMove = ta.sma(absMove, length)
    float path = avgMove * length
    float net = math.abs(close - close[length])
    path > 0.0 ? net / path : 0.0

// 上一根(高周期)已确认的 ER —— 防重绘。需在 request.security 内求值。
f_erPrev(int length) =>
    f_er(length)[1]

// 归一化斜率:EMA 位移 / ATR / lookback。
f_slopeATR(int emaLength, int atrLength, int lookback) =>
    float m = ta.ema(close, emaLength)
    float a = math.max(ta.atr(atrLength), syminfo.mintick)
    (m - m[lookback]) / a / lookback

// 上一根(高周期)已确认的斜率 —— 防重绘。需在 request.security 内求值。
f_slopeATRPrev(int emaLength, int atrLength, int lookback) =>
    f_slopeATR(emaLength, atrLength, lookback)[1]

// 单维度环境分:25 分满分,随 |value|/ideal 衰减,截断到 [0, 25]。
f_score(float value, float idealLimit) =>
    float ratio = idealLimit > 0.0 ? math.abs(value) / idealLimit : 10.0
    float rawScore = 25.0 * (1.0 - ratio)
    float floorScore = math.max(rawScore, 0.0)
    math.min(floorScore, 25.0)


// ============================================================================
// Mean / ATR
// ============================================================================

mean15 = ta.ema(close, meanLen)
atr15 = ta.atr(atrLen)
safeATR = math.max(atr15, syminfo.mintick)


// ============================================================================
// Residual / Z-score
// ============================================================================

residual = close - mean15
residualStd = ta.stdev(residual, zLen)
safeStd = math.max(nz(residualStd), syminfo.mintick)
z = residual / safeStd


// ============================================================================
// 动态区间
// ============================================================================

upperRangeBand = mean15 + rangeEntryZ * safeStd
lowerRangeBand = mean15 - rangeEntryZ * safeStd

upperShockBand = mean15 + shockEntryZ * safeStd
lowerShockBand = mean15 - shockEntryZ * safeStd

upperStopBand = mean15 + stopZ * safeStd
lowerStopBand = mean15 - stopZ * safeStd


// ============================================================================
// Local Regime (15m)
// ============================================================================

localSlopeATR = (mean15 - mean15[localSlopeLookback]) / safeATR / localSlopeLookback
localER = f_er(localERLen)


// ============================================================================
// Confirmed 1H Regime (防重绘:取上一根已确认的 1H bar 值)
// ============================================================================

htfSlopeATR = request.security(syminfo.tickerid, htfTf, f_slopeATRPrev(htfMeanLen, atrLen, htfSlopeLookback), lookahead = barmerge.lookahead_on)
htfER = request.security(syminfo.tickerid, htfTf, f_erPrev(htfERLen), lookahead = barmerge.lookahead_on)


// ============================================================================
// Regime Score
// ============================================================================

htfSlopeScore = f_score(htfSlopeATR, idealHtfSlope)
htfERScore = f_score(htfER, idealHtfER)
localSlopeScore = f_score(localSlopeATR, idealLocalSlope)
localERScore = f_score(localER, idealLocalER)

rawRegimeScore = htfSlopeScore + htfERScore + localSlopeScore + localERScore
regimeScore = ta.sma(rawRegimeScore, regimeSmoothLen)


// ============================================================================
// Hard Trend Veto
// ============================================================================

htfSlopeVeto = math.abs(htfSlopeATR) >= vetoHtfSlope
localSlopeVeto = math.abs(localSlopeATR) >= vetoLocalSlope
htfERVeto = htfER >= vetoHtfER
localERVeto = localER >= vetoLocalER

hardTrendVeto = htfSlopeVeto or localSlopeVeto or htfERVeto or localERVeto

rangeEnvironment = not hardTrendVeto and regimeScore >= rangeMinScore
shockEnvironment = not hardTrendVeto and regimeScore >= shockMinScore


// ============================================================================
// Shock Detection
// ============================================================================
// Shock 强度:最近 N 根走了多少 ATR。

shockMove = (close - close[shockLookback]) / safeATR
shockUp = shockMove >= minShockATR
shockDown = shockMove <= -minShockATR

// 当前冲击 vs 前一段冲击:开始减弱 → 更像过冲结束。
previousShockMove = (close[shockLookback] - close[shockLookback * 2]) / safeATR
shockDecelerating = math.abs(shockMove) <= math.abs(previousShockMove) * decelerationRatio
decelerationOK = not requireShockDeceleration or shockDecelerating


// ============================================================================
// Candle / Wick Rejection
// ============================================================================

barRange = math.max(high - low, syminfo.mintick)

lowerWick = math.min(open, close) - low
upperWick = high - math.max(open, close)

lowerWickRatio = lowerWick / barRange
upperWickRatio = upperWick / barRange

bullishCandle = close > open
bearishCandle = close < open

longRejection = bullishCandle or lowerWickRatio >= minWickRatio
shortRejection = bearishCandle or upperWickRatio >= minWickRatio

longRejectionOK = not requireRejection or longRejection
shortRejectionOK = not requireRejection or shortRejection


// ============================================================================
// Half-Life
// ============================================================================
// 对 d(residual) ~ beta * residual[-1] 回归,Half-Life = -ln(2) / beta。
// beta 为正(动量)或无效时,退化到 fallbackTimeStopBars。

residualLag = residual[1]
residualDelta = residual - residual[1]

hlCorr = ta.correlation(residualDelta, residualLag, halfLifeLookback)
hlDeltaStd = ta.stdev(residualDelta, halfLifeLookback)
hlLagStd = ta.stdev(residualLag, halfLifeLookback)

bool betaOK = not na(hlCorr) and not na(hlDeltaStd) and not na(hlLagStd) and hlLagStd > 0.0

float hlBeta = na

if betaOK
    hlBeta := hlCorr * hlDeltaStd / hlLagStd

float halfLife = na

if not na(hlBeta) and hlBeta < -0.000001
    halfLife := -math.log(2.0) / hlBeta


// ============================================================================
// 全局 Cross
// ============================================================================

zCrossOverNegRange = ta.crossover(z, -rangeEntryZ)
zCrossUnderPosRange = ta.crossunder(z, rangeEntryZ)

zCrossOverNegShock = ta.crossover(z, -shockEntryZ)
zCrossUnderPosShock = ta.crossunder(z, shockEntryZ)


// ============================================================================
// State
// ============================================================================
// MRState 只保存 confirmed-bar setup 与 signal context。交易生命周期不放在这里,
// 因为普通 UDT 字段会在同一根 K 线的多次 execution 之间回滚。

type MRState
    int    setupBar      = na    // 活跃 Setup 的 bar_index
    int    setupDir      = 0     // Setup 方向:+1 / -1
    int    setupMode     = 0     // 0 无 / 1 Range / 2 Shock

    // Market order 在信号 bar 收盘生成,下一可成交时点才建立持仓。
    int    pendingDir    = 0
    int    pendingMode   = 0
    int    pendingBar    = na
    float  pendingMean   = na
    float  pendingStd    = na
    float  pendingAtr    = na
    int    pendingTimeStop = na

var MRState t = MRState.new()

// TradingView strategy orders / position state do not roll back between fill executions,
// while normal Pine variables may roll back to the last committed bar state.
//
// This intrabar state exists only to synchronize real Broker Emulator fills.
// It must not be used to introduce new intrabar signal decisions.
type MRFillState
    // Execution-to-execution broker position tracker.
    varip bool   trackerReady = false
    varip float  previousExecutionPositionSize = na
    varip int    observedClosedTrades = 0

    // Signal context is copied here when the confirmed-bar entry order is emitted.
    varip bool   pendingEntry = false
    varip int    pendingDir = 0
    varip int    pendingMode = 0
    varip int    pendingBar = na
    varip float  pendingMean = na
    varip float  pendingStd = na
    varip float  pendingAtr = na
    varip int    pendingTimeStop = na

    // Frozen trade context and real fill lifecycle.
    varip bool   active = false
    varip int    pos = 0
    varip int    entryBar = na
    varip float  entryPrice = na
    varip float  entrySize = na
    varip float  mean = na
    varip float  std = na
    varip float  atr = na
    varip float  partialTarget = na
    varip float  finalTarget = na
    varip float  baseStop = na
    varip int    timeStop = na
    varip int    tradeMode = 0
    varip float  cost = 0.0
    varip float  netProfitAtEntry = na
    varip int    lastExitBar = na
    varip int    exitReasonPending = 0
    varip bool   exitRequested = false
    varip bool   marketClosePlaced = false
    varip bool   trimRequested = false
    varip bool   partialTaken = false
    varip int    partialBar = na

    // Broker/fill-state recovery is separate from the normal trade lifecycle.
    // A recovery never contributes to Range/Shock Closed or Wins statistics.
    varip bool   consistencyRecoveryPending = false
    varip bool   consistencyRecoveryClosePlaced = false
    varip int    consistencyRecoveryState = 0
    varip int    consistencyRecoveryCount = 0
    varip int    latestClosedExitCode = 0

    // Range / Shock auxiliary statistics; formal performance remains Strategy Tester.
    varip int    rangeEntries = 0
    varip int    rangeClosed = 0
    varip int    rangeWins = 0
    varip int    shockEntries = 0
    varip int    shockClosed = 0
    varip int    shockWins = 0

    // Shock confirmed-close funnel diagnostics. Each layer includes all prior
    // layers and is counted only while the strategy is eligible to seek Entry.
    varip int    shockZCandidates = 0
    varip int    shockMoveCandidates = 0
    varip int    shockEnvironmentPass = 0
    varip int    shockDecelerationPass = 0
    varip int    shockRejectionPass = 0
    varip int    shockSetups = 0
    varip int    shockConfirmedEntries = 0

    // One execution-local display event, retained until the next execution reset.
    varip int    eventKind = 0     // 0 none / 1 entry / 2 trim / 3 exit
    varip int    eventDir = 0
    varip int    eventReason = 0
    varip int    eventMode = 0
    varip float  eventPrice = na

var MRFillState fillState = MRFillState.new()

f_clearPendingSignal() =>
    t.pendingDir := 0
    t.pendingMode := 0
    t.pendingBar := na
    t.pendingMean := na
    t.pendingStd := na
    t.pendingAtr := na
    t.pendingTimeStop := na

f_clearTradeContext() =>
    fillState.active := false
    fillState.pos := 0
    fillState.partialTaken := false
    fillState.partialBar := na
    fillState.trimRequested := false

    fillState.entryBar := na
    fillState.entryPrice := na
    fillState.entrySize := na
    fillState.mean := na
    fillState.std := na
    fillState.atr := na
    fillState.partialTarget := na
    fillState.finalTarget := na
    fillState.baseStop := na
    fillState.timeStop := na
    fillState.tradeMode := 0
    fillState.cost := 0.0
    fillState.netProfitAtEntry := na
    fillState.exitReasonPending := 0
    fillState.exitRequested := false
    fillState.marketClosePlaced := false

    fillState.pendingEntry := false
    fillState.pendingDir := 0
    fillState.pendingMode := 0
    fillState.pendingBar := na
    fillState.pendingMean := na
    fillState.pendingStd := na
    fillState.pendingAtr := na
    fillState.pendingTimeStop := na
    f_clearPendingSignal()

    t.setupBar := na
    t.setupDir := 0
    t.setupMode := 0

// 一次性事件:Pine 禁止在函数内重赋任何全局变量(CE10088),函数只能改对象字段。
// 因此成交事件先写入 fillState 的捕获字段,全局作用域再派生为这些变量。
bool setupEvent      = false
int  setupEventDir   = 0
int  setupEventMode  = 0

bool entryEvent      = false
int  entryEventDir   = 0

bool partialEvent    = false
int  partialEventDir = 0

bool exitEvent       = false
int  exitEventDir    = 0
int  exitReason      = 0

// 每次脚本 execution 重置当前事件。策略开启 calc_on_order_fills 后,同一根 K 线
// 可能执行多次;事件只在实际成交的 execution 中产生。
fillState.eventKind := 0
fillState.eventDir := 0
fillState.eventReason := 0
fillState.eventMode := 0
fillState.eventPrice := na

// 退出原因枚举
int R_STOP  = 1
int R_TREND = 2
int R_TIME  = 3
int R_FINAL = 4
int R_BE    = 5
int R_STATE_RECOVERY = 6

// Broker/fill-state consistency classifier.  The broker position remains the
// final source of truth; these states describe whether the frozen lifecycle can
// safely manage it.
int CONSISTENCY_OK_FLAT = 0
int CONSISTENCY_OK_LONG = 1
int CONSISTENCY_OK_SHORT = 2
int CONSISTENCY_PENDING_ENTRY = 3
int CONSISTENCY_STALE_ACTIVE_FLAT = 4
int CONSISTENCY_DIRECTION_MISMATCH = 5
int CONSISTENCY_ORPHAN_BROKER = 6
int CONSISTENCY_DIRECT_REVERSAL = 7
int CONSISTENCY_STALE_PENDING = 8
int CONSISTENCY_INVALID_CONTEXT = 9

f_consistencyName(int state) =>
    state == CONSISTENCY_OK_FLAT ? "OK_FLAT" : state == CONSISTENCY_OK_LONG ? "OK_LONG" : state == CONSISTENCY_OK_SHORT ? "OK_SHORT" : state == CONSISTENCY_PENDING_ENTRY ? "PENDING_ENTRY" : state == CONSISTENCY_STALE_ACTIVE_FLAT ? "STALE_ACTIVE_FLAT" : state == CONSISTENCY_DIRECTION_MISMATCH ? "DIRECTION_MISMATCH" : state == CONSISTENCY_ORPHAN_BROKER ? "ORPHAN_BROKER" : state == CONSISTENCY_DIRECT_REVERSAL ? "DIRECT_REVERSAL" : state == CONSISTENCY_STALE_PENDING ? "STALE_PENDING" : "INVALID_CONTEXT"

// --------------------------------------------------------------------------
// Execution-to-execution position transition detection.
// The first execution initializes the tracker to the broker's current size and
// deliberately emits no fill event. This prevents a reload or symbol change
// from treating an already-present position as a new Entry.
float currentPositionSize = strategy.position_size
bool trackerWasReady = fillState.trackerReady
float previousExecutionPositionSize = fillState.previousExecutionPositionSize
int closedTradesNow = strategy.closedtrades

if not trackerWasReady
    fillState.previousExecutionPositionSize := currentPositionSize
    fillState.observedClosedTrades := closedTradesNow
    fillState.trackerReady := true

// The confirmed-bar pending context is kept for the signal/UI state. Once the
// intrabar copy is consumed, clear a rolled-back copy before a later signal.
if not fillState.pendingEntry and t.pendingDir != 0 and not na(t.pendingBar) and t.pendingBar < bar_index
    f_clearPendingSignal()

bool positionSampleReady = trackerWasReady and not na(previousExecutionPositionSize)
bool positionEntered = positionSampleReady and previousExecutionPositionSize == 0.0 and currentPositionSize != 0.0
bool positionClosed = positionSampleReady and previousExecutionPositionSize != 0.0 and currentPositionSize == 0.0
bool sameDirectionPosition = positionSampleReady and previousExecutionPositionSize != 0.0 and currentPositionSize != 0.0 and previousExecutionPositionSize * currentPositionSize > 0.0
bool positionReduced = sameDirectionPosition and math.abs(currentPositionSize) < math.abs(previousExecutionPositionSize)
bool positionChanged = positionSampleReady and currentPositionSize != previousExecutionPositionSize
int previousPositionDir = previousExecutionPositionSize > 0.0 ? 1 : previousExecutionPositionSize < 0.0 ? -1 : 0
int currentPositionDir = currentPositionSize > 0.0 ? 1 : currentPositionSize < 0.0 ? -1 : 0

// A Trim is confirmed only by a real same-direction broker-position reduction
// while the confirmed-close partial market order is pending. The broker
// position, rather than the signal, remains the source of truth.
bool hasNewClosedTrade = positionSampleReady and closedTradesNow > fillState.observedClosedTrades
string latestClosedExitId = hasNewClosedTrade ? strategy.closedtrades.exit_id(closedTradesNow - 1) : ""

if hasNewClosedTrade
    fillState.latestClosedExitCode := latestClosedExitId == "MR-L" ? 1 : latestClosedExitId == "MR-S" ? 2 : latestClosedExitId == "" ? 0 : 3

bool trimFilled = positionReduced and fillState.active and not fillState.partialTaken and fillState.trimRequested
bool entryFilled = positionEntered and not fillState.active
bool entryContextAvailable = fillState.pendingEntry and fillState.pendingDir == currentPositionDir
bool fullExitFilled = positionClosed and fillState.active and fillState.pos != 0 and fillState.exitRequested and fillState.marketClosePlaced

// Classify the broker/fill-state relationship before any new lifecycle work.
// Direct reversals have priority over all other mismatches because they prove
// that an exit order crossed zero and must never be treated as a new Entry.
bool directionReversed = positionSampleReady and previousExecutionPositionSize * currentPositionSize < 0.0
bool priorBrokerDirectionMismatch = positionSampleReady and previousPositionDir != 0 and fillState.active and previousPositionDir != fillState.pos
bool staleActiveFlat = currentPositionSize == 0.0 and (fillState.active or fillState.pos != 0) and (not fullExitFilled or priorBrokerDirectionMismatch)
bool brokerDirectionMismatch = currentPositionSize != 0.0 and fillState.active and currentPositionDir != fillState.pos
bool pendingDirectionMismatch = currentPositionSize != 0.0 and fillState.pendingEntry and currentPositionDir != fillState.pendingDir
bool stalePendingEntry = currentPositionSize != 0.0 and fillState.pendingEntry and not positionEntered
bool activePendingConflict = (fillState.active or fillState.pos != 0) and fillState.pendingEntry
bool orphanBrokerPosition = currentPositionSize != 0.0 and not fillState.active and not fillState.pendingEntry
bool frozenContextInvalid = fillState.active and (na(fillState.entryPrice) or na(fillState.entrySize) or fillState.entrySize <= 0.0 or na(fillState.partialTarget) or na(fillState.finalTarget) or na(fillState.baseStop))
bool unexpectedSameDirectionReduction = positionReduced and fillState.active and not trimFilled
bool unexpectedSameDirectionIncrease = sameDirectionPosition and math.abs(currentPositionSize) > math.abs(previousExecutionPositionSize) and fillState.active

int consistencyState = currentPositionSize == 0.0 ? CONSISTENCY_OK_FLAT : CONSISTENCY_ORPHAN_BROKER
bool consistencyRecoveryRequired = false

if fillState.consistencyRecoveryPending
    if currentPositionSize == 0.0
        f_clearTradeContext()
        fillState.consistencyRecoveryPending := false
        fillState.consistencyRecoveryClosePlaced := false
        consistencyState := CONSISTENCY_OK_FLAT
    else
        consistencyState := fillState.consistencyRecoveryState
        consistencyRecoveryRequired := true
else if directionReversed
    consistencyState := CONSISTENCY_DIRECT_REVERSAL
    consistencyRecoveryRequired := true
else if priorBrokerDirectionMismatch
    consistencyState := CONSISTENCY_DIRECTION_MISMATCH
    consistencyRecoveryRequired := true
else if staleActiveFlat
    consistencyState := CONSISTENCY_STALE_ACTIVE_FLAT
    consistencyRecoveryRequired := true
else if activePendingConflict or brokerDirectionMismatch or pendingDirectionMismatch
    consistencyState := CONSISTENCY_DIRECTION_MISMATCH
    consistencyRecoveryRequired := true
else if frozenContextInvalid
    consistencyState := CONSISTENCY_INVALID_CONTEXT
    consistencyRecoveryRequired := true
else if unexpectedSameDirectionReduction or unexpectedSameDirectionIncrease
    consistencyState := CONSISTENCY_INVALID_CONTEXT
    consistencyRecoveryRequired := true
else if stalePendingEntry
    consistencyState := CONSISTENCY_STALE_PENDING
    consistencyRecoveryRequired := true
else if orphanBrokerPosition
    consistencyState := CONSISTENCY_ORPHAN_BROKER
    consistencyRecoveryRequired := true
else if fillState.pendingEntry
    consistencyState := CONSISTENCY_PENDING_ENTRY
else if currentPositionSize != 0.0 and fillState.active and currentPositionDir == fillState.pos
    consistencyState := currentPositionDir == 1 ? CONSISTENCY_OK_LONG : CONSISTENCY_OK_SHORT

// Recovery is an explicit state repair, not a normal Stop/Final/Trend exit.
// Cancel every outstanding MR order before clearing the frozen context; if a
// broker position remains, close the unknown/reversed net position once.
if consistencyRecoveryRequired
    bool startingRecovery = not fillState.consistencyRecoveryPending

    if startingRecovery
        fillState.consistencyRecoveryCount += 1
        fillState.consistencyRecoveryState := consistencyState
        fillState.consistencyRecoveryClosePlaced := false
        strategy.cancel_all()

    fillState.eventReason := R_STATE_RECOVERY
    f_clearTradeContext()
    fillState.lastExitBar := bar_index

    if currentPositionSize != 0.0
        fillState.consistencyRecoveryPending := true

        if not fillState.consistencyRecoveryClosePlaced
            string recoveryDirection = currentPositionDir == 1 ? "Long" : "Short"
            strategy.close_all(comment = "MR-T State Recovery", alert_message = "MR-T|direction=" + recoveryDirection + "|event=State Recovery|price=" + str.tostring(close, format.mintick))
            fillState.consistencyRecoveryClosePlaced := true
    else
        fillState.consistencyRecoveryPending := false
        fillState.consistencyRecoveryClosePlaced := false

// Fill recalculations may see confirmed historical OHLC values, so they may
// synchronize real fills and maintain orders, but may not make bar-close
// trading decisions. barstate.isconfirmed alone is not sufficient.
bool isFillSynchronizationExecution = positionChanged
bool allowBarCloseDecision = barstate.isconfirmed and not isFillSynchronizationExecution and not consistencyRecoveryRequired

// 冷却
int barsSinceExit = 100000

if not na(fillState.lastExitBar)
    barsSinceExit := bar_index - fillState.lastExitBar

int requiredCooldown = math.max(cooldownBars, 1)
bool canEnter = not consistencyRecoveryRequired and currentPositionSize == 0.0 and not fillState.active and not fillState.pendingEntry and (na(fillState.lastExitBar) or barsSinceExit >= requiredCooldown)


// ============================================================================
// 创建 Setup (Shock 优先于 Range;方向反转允许替换对侧 Setup)
// ============================================================================

bool longShockZCandidate = allowLong and z <= -shockEntryZ
bool shortShockZCandidate = allowShort and z >= shockEntryZ
bool longShockMoveCandidate = longShockZCandidate and shockDown
bool shortShockMoveCandidate = shortShockZCandidate and shockUp
bool longShockEnvironmentCandidate = longShockMoveCandidate and shockEnvironment
bool shortShockEnvironmentCandidate = shortShockMoveCandidate and shockEnvironment
bool longShockDecelerationCandidate = longShockEnvironmentCandidate and decelerationOK
bool shortShockDecelerationCandidate = shortShockEnvironmentCandidate and decelerationOK
bool longShockRejectionCandidate = longShockDecelerationCandidate and longRejectionOK
bool shortShockRejectionCandidate = shortShockDecelerationCandidate and shortRejectionOK

if allowBarCloseDecision and canEnter

    fillState.shockZCandidates += (longShockZCandidate ? 1 : 0) + (shortShockZCandidate ? 1 : 0)
    fillState.shockMoveCandidates += (longShockMoveCandidate ? 1 : 0) + (shortShockMoveCandidate ? 1 : 0)
    fillState.shockEnvironmentPass += (longShockEnvironmentCandidate ? 1 : 0) + (shortShockEnvironmentCandidate ? 1 : 0)
    fillState.shockDecelerationPass += (longShockDecelerationCandidate ? 1 : 0) + (shortShockDecelerationCandidate ? 1 : 0)
    fillState.shockRejectionPass += (longShockRejectionCandidate ? 1 : 0) + (shortShockRejectionCandidate ? 1 : 0)

    bool noSameLong  = na(t.setupBar) or t.setupDir != 1
    bool noSameShort = na(t.setupBar) or t.setupDir != -1

    bool longShockSetup = longShockRejectionCandidate and noSameLong
    bool shortShockSetup = shortShockRejectionCandidate and noSameShort
    bool longRangeSetup = allowLong and rangeEnvironment and z <= -rangeEntryZ and noSameLong
    bool shortRangeSetup = allowShort and rangeEnvironment and z >= rangeEntryZ and noSameShort

    if longShockSetup
        fillState.shockSetups += 1
        t.setupBar := bar_index
        t.setupDir := 1
        t.setupMode := 2
        setupEvent := true
        setupEventDir := 1
        setupEventMode := 2

    else if shortShockSetup
        fillState.shockSetups += 1
        t.setupBar := bar_index
        t.setupDir := -1
        t.setupMode := 2
        setupEvent := true
        setupEventDir := -1
        setupEventMode := 2

    else if longRangeSetup
        t.setupBar := bar_index
        t.setupDir := 1
        t.setupMode := 1
        setupEvent := true
        setupEventDir := 1
        setupEventMode := 1

    else if shortRangeSetup
        t.setupBar := bar_index
        t.setupDir := -1
        t.setupMode := 1
        setupEvent := true
        setupEventDir := -1
        setupEventMode := 1


// ============================================================================
// Setup Expiry
// ============================================================================

if allowBarCloseDecision and not na(t.setupBar)
    int allowedAge = t.setupMode == 2 ? shockSetupBars : rangeSetupBars

    if bar_index - t.setupBar > allowedAge
        t.setupBar := na
        t.setupDir := 0
        t.setupMode := 0


// ============================================================================
// Setup 提前失败 (Z 走极端)
// ============================================================================

if allowBarCloseDecision and not na(t.setupBar) and t.setupDir * z <= -stopZ
    t.setupBar := na
    t.setupDir := 0
    t.setupMode := 0


// ============================================================================
// Entry Confirmation
// ============================================================================

float entryZ = t.setupMode == 2 ? shockEntryZ : rangeEntryZ

bool candleOK = false

if t.setupDir == 1
    candleOK := not requireCandleConfirm or close > close[1]
else if t.setupDir == -1
    candleOK := not requireCandleConfirm or close < close[1]

bool zReclaim = false

if t.setupDir == 1
    zReclaim := t.setupMode == 2 ? zCrossOverNegShock : zCrossOverNegRange
else if t.setupDir == -1
    zReclaim := t.setupMode == 2 ? zCrossUnderPosShock : zCrossUnderPosRange

// requireBandReclaim 使用价格重新进入对应 Entry Z 区间的明确定义。
// zReclaim 仍是独立且必要的 Entry Confirmation 条件。
bool priceBandReclaim = false

if t.setupDir == 1
    priceBandReclaim := close > mean15 - entryZ * safeStd
else if t.setupDir == -1
    priceBandReclaim := close < mean15 + entryZ * safeStd

bool bandOK = not requireBandReclaim or priceBandReclaim

bool flatForEntry = not consistencyRecoveryRequired and currentPositionSize == 0.0 and not fillState.active and not fillState.pendingEntry
bool longEntrySignal = allowBarCloseDecision and flatForEntry and not hardTrendVeto and t.setupDir == 1 and not na(t.setupBar) and zReclaim and bandOK and candleOK
bool shortEntrySignal = allowBarCloseDecision and flatForEntry and not hardTrendVeto and t.setupDir == -1 and not na(t.setupBar) and zReclaim and bandOK and candleOK


// ============================================================================
// 活跃止损 (含 T减后保本偏移 —— 单一事实来源,管理逻辑与绘图共用)
// ============================================================================

f_activeStop(int dir) =>
    float s = fillState.baseStop

    if moveStopToBE and fillState.partialTaken
        s := dir == 1 ? math.max(s, fillState.entryPrice + fillState.cost) : math.min(s, fillState.entryPrice - fillState.cost)

    s


// ============================================================================
// Alert / cost helpers
// ============================================================================

// TradingView Strategy Tester 的 commission/slippage 是 strategy() 的
// 编译期属性,不能由 input 动态改写。这里的估算只服务于 T减后的 BE 价格;
// 正式净利润、胜率与回撤全部读取 strategy.*。
f_roundTripCost(float price) =>
    float commissionCost = price * (2.0 * commissionBps) / 10000.0
    float slippageCost = 2.0 * slippageTicks * syminfo.mintick
    commissionCost + slippageCost

f_modeName(int mode) =>
    mode == 2 ? "Shock" : "Range"

f_directionName(int dir) =>
    dir == 1 ? "Long" : "Short"

f_orderMessage(int dir, string eventName, int mode, float price) =>
    "MR-T|direction=" + f_directionName(dir) + "|event=" + eventName + "|mode=" + f_modeName(mode) + "|price=" + str.tostring(price, format.mintick)

f_exitName(int reason) =>
    reason == R_FINAL ? "Final Exit" : reason == R_TREND ? "Trend Fail" : reason == R_TIME ? "Timeout" : reason == R_BE ? "Breakeven" : "Stop"

f_recentExitPrice(float fallback) =>
    float exitPrice = fallback

    if strategy.closedtrades > 0
        int lastTrade = strategy.closedtrades - 1

        if strategy.closedtrades.exit_bar_index(lastTrade) == bar_index
            exitPrice := strategy.closedtrades.exit_price(lastTrade)

    exitPrice


// ============================================================================
// Entry lifecycle
// ============================================================================
// 信号 bar 只提交市场订单并冻结信号上下文。订单在下一可成交时点成交后,
// 才用 strategy.position_avg_price 初始化实际交易;目标/止损因此不再把 close
// 当作成交价的唯一事实来源。

f_enter(int dir) =>
    t.pendingDir := dir
    t.pendingMode := t.setupMode
    t.pendingBar := bar_index
    t.pendingMean := mean15
    t.pendingStd := safeStd
    t.pendingAtr := safeATR

    float rawTimeStop = fallbackTimeStopBars

    if not na(halfLife)
        rawTimeStop := halfLife * timeStopMultiplier

    float limitedTimeStop = math.max(minTimeStopBars, rawTimeStop)
    limitedTimeStop := math.min(maxTimeStopBars, limitedTimeStop)
    t.pendingTimeStop := int(math.round(limitedTimeStop))

    // Keep a rollback-safe copy for the later actual position transition.
    fillState.pendingEntry := true
    fillState.pendingDir := dir
    fillState.pendingMode := t.pendingMode
    fillState.pendingBar := t.pendingBar
    fillState.pendingMean := t.pendingMean
    fillState.pendingStd := t.pendingStd
    fillState.pendingAtr := t.pendingAtr
    fillState.pendingTimeStop := t.pendingTimeStop

    t.setupBar := na
    t.setupDir := 0
    t.setupMode := 0

f_initializeTrade(int dir) =>
    if not fillState.active and fillState.pendingEntry and fillState.pendingDir == dir
        float filledPrice = strategy.position_avg_price

        fillState.active := true
        fillState.pos := dir
        fillState.entryBar := bar_index
        fillState.entryPrice := filledPrice
        fillState.entrySize := math.abs(strategy.position_size)
        fillState.mean := fillState.pendingMean
        fillState.std := fillState.pendingStd
        fillState.atr := fillState.pendingAtr
        fillState.tradeMode := fillState.pendingMode
        fillState.timeStop := fillState.pendingTimeStop
        fillState.partialTaken := false
        fillState.partialBar := na
        fillState.trimRequested := false

        float pz = fillState.tradeMode == 2 ? shockPartialZ : rangePartialZ
        float ez = fillState.tradeMode == 2 ? shockExitZ : rangeExitZ

        // 目标价统一表达为 mean - dir * Z * std,并在真实 Entry 建立后冻结。
        fillState.partialTarget := fillState.mean - dir * pz * fillState.std
        fillState.finalTarget := fillState.mean - dir * ez * fillState.std

        float atrStop = fillState.entryPrice - dir * hardStopATR * fillState.atr
        float statStop = fillState.mean - dir * stopZ * fillState.std
        float tightStop = dir == 1 ? math.max(atrStop, statStop) : math.min(atrStop, statStop)
        float looseStop = dir == 1 ? math.min(atrStop, statStop) : math.max(atrStop, statStop)
        float balStop = looseStop + (tightStop - looseStop) * balancedWeight

        if stopMode == "Tight"
            fillState.baseStop := tightStop
        else if stopMode == "Loose"
            fillState.baseStop := looseStop
        else
            fillState.baseStop := balStop

        fillState.cost := f_roundTripCost(fillState.entryPrice)
        fillState.netProfitAtEntry := strategy.netprofit
        fillState.exitReasonPending := 0
        fillState.exitRequested := false
        fillState.marketClosePlaced := false

        if fillState.tradeMode == 1
            fillState.rangeEntries += 1
        else
            fillState.shockEntries += 1

        fillState.pendingEntry := false
        fillState.pendingDir := 0
        fillState.pendingMode := 0
        fillState.pendingBar := na
        fillState.pendingMean := na
        fillState.pendingStd := na
        fillState.pendingAtr := na
        fillState.pendingTimeStop := na
        f_clearPendingSignal()

        fillState.eventKind := 1
        fillState.eventDir := dir
        fillState.eventMode := fillState.tradeMode
        fillState.eventPrice := fillState.entryPrice

f_markPartial(int dir) =>
    if fillState.active and fillState.pos == dir and not fillState.partialTaken
        fillState.partialTaken := true
        fillState.partialBar := bar_index
        fillState.trimRequested := false
        fillState.eventKind := 2
        fillState.eventDir := dir
        fillState.eventMode := fillState.tradeMode
        fillState.eventPrice := f_recentExitPrice(fillState.partialTarget)

f_exit(int dir, int reason) =>
    if fillState.active and fillState.pos == dir
        int finishedMode = fillState.tradeMode
        float tradeNetProfit = na(fillState.netProfitAtEntry) ? 0.0 : strategy.netprofit - fillState.netProfitAtEntry
        bool winningTrade = tradeNetProfit > 0.0
        float finishedPrice = f_recentExitPrice(close)

        if finishedMode == 1
            fillState.rangeClosed += 1

            if winningTrade
                fillState.rangeWins += 1
        else if finishedMode == 2
            fillState.shockClosed += 1

            if winningTrade
                fillState.shockWins += 1

        fillState.lastExitBar := bar_index
        f_clearTradeContext()

        fillState.eventKind := 3
        fillState.eventDir := dir
        fillState.eventReason := reason
        fillState.eventMode := finishedMode
        fillState.eventPrice := finishedPrice


// ============================================================================
// Manage (方向参数化 · confirmed-close only)
// ============================================================================
// 所有价格水平只作为 confirmed 15m close 的决策阈值，不挂盘中 stop/limit
// 价格订单。每根正常收盘 execution 最多选择一个事件，优先级为:
// Stop/BE → Trend Fail → Timeout → Trim → Final。

f_manage(int dir, bool allowBarCloseDecision, bool tradeContextValid) =>
    bool afterEntryBar = not na(fillState.entryBar) and bar_index > fillState.entryBar
    bool afterTrimFillBar = not fillState.partialTaken or (not na(fillState.partialBar) and bar_index > fillState.partialBar)
    bool canManage = tradeContextValid and fillState.pos == dir and currentPositionSize * dir > 0.0 and afterEntryBar and afterTrimFillBar

    // Entry/Trim/Exit fill recalculations synchronize state only. Pending orders
    // also block a second lifecycle decision before the real fill is observed.
    if allowBarCloseDecision and canManage and not fillState.exitRequested and not fillState.trimRequested
        float activeStop = f_activeStop(dir)
        bool stopFailed = dir == 1 ? close <= activeStop : close >= activeStop
        bool trendFailed = dir * htfSlopeATR <= -vetoHtfSlope or dir * localSlopeATR <= -vetoLocalSlope
        bool timeFailed = not na(fillState.timeStop) and (bar_index - fillState.entryBar) >= fillState.timeStop
        bool trimReached = not fillState.partialTaken and (dir == 1 ? close >= fillState.partialTarget : close <= fillState.partialTarget)
        bool finalEligible = fillState.partialTaken and not na(fillState.partialBar) and bar_index > fillState.partialBar
        bool finalReached = finalEligible and (dir == 1 ? close >= fillState.finalTarget : close <= fillState.finalTarget)

        if stopFailed
            fillState.exitRequested := true
            fillState.exitReasonPending := fillState.partialTaken and moveStopToBE ? R_BE : R_STOP
        else if trendFailed
            fillState.exitRequested := true
            fillState.exitReasonPending := R_TREND
        else if timeFailed
            fillState.exitRequested := true
            fillState.exitReasonPending := R_TIME
        else if trimReached
            fillState.trimRequested := true
        else if finalReached
            fillState.exitRequested := true
            fillState.exitReasonPending := R_FINAL


// ============================================================================
// 执行入口 / 状态同步 / 订单管理
// ============================================================================

if longEntrySignal
    if t.setupMode == 2
        fillState.shockConfirmedEntries += 1
    f_enter(1)
    strategy.entry("MR-L", strategy.long, alert_message = f_orderMessage(1, "Long Entry", t.pendingMode, close))
    alert(f_orderMessage(1, "Long Entry", t.pendingMode, close), alert.freq_all)
    consistencyState := CONSISTENCY_PENDING_ENTRY
else if shortEntrySignal
    if t.setupMode == 2
        fillState.shockConfirmedEntries += 1
    f_enter(-1)
    strategy.entry("MR-S", strategy.short, alert_message = f_orderMessage(-1, "Short Entry", t.pendingMode, close))
    alert(f_orderMessage(-1, "Short Entry", t.pendingMode, close), alert.freq_all)
    consistencyState := CONSISTENCY_PENDING_ENTRY

// 市场订单在下一可成交时点建立后,同步 Strategy Tester 的真实持仓。
// Entry 的事实来源是 0 -> 非 0 的 broker position transition;pending state 只
// 提供已经冻结的信号上下文,不能单独决定是否发生了成交。
if entryFilled and entryContextAvailable and not consistencyRecoveryRequired
    f_initializeTrade(currentPositionDir)
    consistencyState := currentPositionDir == 1 ? CONSISTENCY_OK_LONG : CONSISTENCY_OK_SHORT

// 只有 confirmed-close Trim 请求导致真实仓位减少后才标记 T减。
if trimFilled and not consistencyRecoveryRequired
    f_markPartial(fillState.pos)

// A valid trade context must agree with the broker direction and contain every
// frozen level used by confirmed-close management. Invalid contexts never
// submit a lifecycle order or draw old trade lines.
bool tradeContextValid = not consistencyRecoveryRequired and not fillState.consistencyRecoveryPending and fillState.active and fillState.pos != 0 and currentPositionSize * fillState.pos > 0.0 and currentPositionDir == fillState.pos and not na(fillState.entryPrice) and not na(fillState.entrySize) and fillState.entrySize > 0.0 and not na(fillState.partialTarget) and not na(fillState.finalTarget) and not na(fillState.baseStop)

f_manage(1, allowBarCloseDecision, tradeContextValid)
f_manage(-1, allowBarCloseDecision, tradeContextValid)

// A confirmed Trim decision submits a partial market close against the stable
// Entry ID. partialTaken remains false until the broker position really shrinks.
if tradeContextValid and fillState.trimRequested and not fillState.partialTaken
    string trimEntryId = fillState.pos == 1 ? "MR-L" : "MR-S"
    strategy.close(trimEntryId, comment = "Trim", qty_percent = trimPct, alert_message = f_orderMessage(fillState.pos, "Trim", fillState.tradeMode, close), immediately = false)

// Stop/BE, Trend Fail, Timeout, and Final all close the actual remainder with a
// market order. Lifecycle reset waits for the broker position to become flat.
if tradeContextValid and fillState.exitRequested and not fillState.marketClosePlaced
    string closeEntryId = fillState.pos == 1 ? "MR-L" : "MR-S"
    string closeEvent = f_exitName(fillState.exitReasonPending)
    strategy.close(closeEntryId, comment = closeEvent, alert_message = f_orderMessage(fillState.pos, closeEvent, fillState.tradeMode, close), immediately = false)
    fillState.marketClosePlaced := true

// 识别真实持仓归零,再 reset fillState。这样 Strategy Tester 的订单生命周期
// 与图表状态不会因“信号触发”而提前脱钩。
if fullExitFilled and not consistencyRecoveryRequired
    int actualReason = fillState.exitReasonPending

    if actualReason == 0
        actualReason := R_STOP

    if actualReason == R_STOP and fillState.partialTaken and moveStopToBE
        actualReason := R_BE

    int closedDir = fillState.pos
    f_exit(closedDir, actualReason)
    consistencyState := CONSISTENCY_OK_FLAT

// The broker position sample is committed only after all transitions have been
// classified and the corresponding lifecycle state has been synchronized.
fillState.previousExecutionPositionSize := currentPositionSize
fillState.observedClosedTrades := closedTradesNow

// 派生一次性显示事件(全局作用域写全局变量是允许的)
entryEvent := fillState.eventKind == 1
entryEventDir := fillState.eventDir
partialEvent := fillState.eventKind == 2
partialEventDir := fillState.eventDir
exitEvent := fillState.eventKind == 3
exitEventDir := fillState.eventDir
exitReason := fillState.eventReason
int eventMode = fillState.eventMode
float eventPrice = fillState.eventPrice


// ============================================================================
// Plot Mean
// ============================================================================

plot(mean15, "Local Mean", color = color.yellow, linewidth = 2)


// ============================================================================
// Bands
// ============================================================================

pRangeUpper = plot(showBands ? upperRangeBand : na, "Range +Z", color = color.new(color.orange, 35))
pRangeLower = plot(showBands ? lowerRangeBand : na, "Range -Z", color = color.new(color.aqua, 35))

pShockUpper = plot(showBands ? upperShockBand : na, "Shock +Z", color = color.new(color.red, 35))
pShockLower = plot(showBands ? lowerShockBand : na, "Shock -Z", color = color.new(color.green, 35))

pStopUpper = plot(showBands ? upperStopBand : na, "Extreme +Z", color = color.new(color.red, 75))
pStopLower = plot(showBands ? lowerStopBand : na, "Extreme -Z", color = color.new(color.red, 75))

fill(pShockUpper, pStopUpper, color = showBands ? color.new(color.red, 94) : na)
fill(pShockLower, pStopLower, color = showBands ? color.new(color.green, 94) : na)


// ============================================================================
// Background
// ============================================================================

color bgCol = na

if showBackground
    if rangeEnvironment
        bgCol := color.new(color.blue, 92)
    else if shockEnvironment
        bgCol := color.new(color.purple, 94)

bgcolor(bgCol, title = "Mean Reversion Environment")


// ============================================================================
// Active Trade Lines
// ============================================================================

float activePartialLine = na
float activeFinalLine = na
float activeRiskLine = na

if tradeContextValid
    activePartialLine := fillState.partialTarget
    activeFinalLine := fillState.finalTarget
    activeRiskLine := f_activeStop(fillState.pos)

plot(showTradeLevels ? activePartialLine : na, "T减目标 / Trim", color = color.orange, linewidth = 2, style = plot.style_linebr)
plot(showTradeLevels ? activeFinalLine : na, "T平目标 / Target", color = color.white, linewidth = 2, style = plot.style_linebr)
plot(showTradeLevels ? activeRiskLine : na, "风险线 / Risk", color = color.red, linewidth = 2, style = plot.style_linebr)


// ============================================================================
// Setup Labels
// ============================================================================
// 用 label.new 而非 plotshape:plotshape 的 text 是 const string,无法随
// lang 切换;label.new 的 text 是 series string,可接 f_tr()。

if showSetup and setupEvent and setupEventMode == 1 and setupEventDir == 1
    label.new(bar_index, low, f_tr("R观察", "R obs"), style = label.style_label_up, color = color.new(color.green, 55), textcolor = color.white, size = size.tiny)

if showSetup and setupEvent and setupEventMode == 1 and setupEventDir == -1
    label.new(bar_index, high, f_tr("R观察", "R obs"), style = label.style_label_down, color = color.new(color.red, 55), textcolor = color.white, size = size.tiny)

if showSetup and setupEvent and setupEventMode == 2 and setupEventDir == 1
    label.new(bar_index, low, f_tr("S观察", "S obs"), style = label.style_label_up, color = color.green, textcolor = color.white, size = size.tiny)

if showSetup and setupEvent and setupEventMode == 2 and setupEventDir == -1
    label.new(bar_index, high, f_tr("S观察", "S obs"), style = label.style_label_down, color = color.red, textcolor = color.white, size = size.tiny)


// ============================================================================
// Entry
// ============================================================================

if entryEvent and entryEventDir == 1
    label.new(bar_index, low, f_tr("T买", "T Long"), style = label.style_label_up, color = color.green, textcolor = color.white, size = size.small)

if entryEvent and entryEventDir == -1
    label.new(bar_index, high, f_tr("T空", "T Short"), style = label.style_label_down, color = color.red, textcolor = color.white, size = size.small)


// ============================================================================
// Partial
// ============================================================================

if partialEvent and partialEventDir == 1
    label.new(bar_index, high, f_tr("T减", "T Trim"), style = label.style_label_down, color = color.orange, textcolor = color.white, size = size.tiny)

if partialEvent and partialEventDir == -1
    label.new(bar_index, low, f_tr("T减", "T Trim"), style = label.style_label_up, color = color.aqua, textcolor = color.black, size = size.tiny)


// ============================================================================
// Exits (Final / Stop / Trend / Time / BE)
// ============================================================================

if exitEvent and exitReason == R_FINAL and exitEventDir == 1
    label.new(bar_index, high, f_tr("T平", "T Close"), style = label.style_label_down, color = color.lime, textcolor = color.black, size = size.small)

if exitEvent and exitReason == R_FINAL and exitEventDir == -1
    label.new(bar_index, low, f_tr("T平", "T Close"), style = label.style_label_up, color = color.lime, textcolor = color.black, size = size.small)

if exitEvent and exitReason == R_STOP and exitEventDir == 1
    label.new(bar_index, high, f_tr("T止损", "T Stop"), style = label.style_label_down, color = color.red, textcolor = color.white, size = size.small)

if exitEvent and exitReason == R_STOP and exitEventDir == -1
    label.new(bar_index, low, f_tr("T止损", "T Stop"), style = label.style_label_up, color = color.red, textcolor = color.white, size = size.small)

if exitEvent and exitReason == R_TREND and exitEventDir == 1
    label.new(bar_index, high, f_tr("趋势失效", "Trend fail"), style = label.style_label_down, color = color.purple, textcolor = color.white, size = size.small)

if exitEvent and exitReason == R_TREND and exitEventDir == -1
    label.new(bar_index, low, f_tr("趋势失效", "Trend fail"), style = label.style_label_up, color = color.purple, textcolor = color.white, size = size.small)

if exitEvent and exitReason == R_TIME and exitEventDir == 1
    label.new(bar_index, high, f_tr("T超时", "T Timeout"), style = label.style_label_down, color = color.gray, textcolor = color.white, size = size.small)

if exitEvent and exitReason == R_TIME and exitEventDir == -1
    label.new(bar_index, low, f_tr("T超时", "T Timeout"), style = label.style_label_up, color = color.gray, textcolor = color.white, size = size.small)

if exitEvent and exitReason == R_BE and exitEventDir == 1
    label.new(bar_index, high, f_tr("T保本", "T BE"), style = label.style_label_down, color = color.gray, textcolor = color.white, size = size.tiny)

if exitEvent and exitReason == R_BE and exitEventDir == -1
    label.new(bar_index, low, f_tr("T保本", "T BE"), style = label.style_label_up, color = color.gray, textcolor = color.white, size = size.tiny)


// ============================================================================
// Data Window
// ============================================================================

plot(z, "Z-score", display = display.data_window)
plot(regimeScore, "Regime Score", display = display.data_window)
plot(halfLife, "Half-Life", display = display.data_window)
plot(shockMove, "Shock ATR", display = display.data_window)
plot(previousShockMove, "Previous Shock ATR", display = display.data_window)
plot(localER, "15m ER", display = display.data_window)
plot(htfER, "1H ER", display = display.data_window)
plot(localSlopeATR, "15m Slope", display = display.data_window)
plot(htfSlopeATR, "1H Slope", display = display.data_window)
plot(strategy.netprofit, "Strategy Tester Net P&L", display = display.data_window)
plot(strategy.position_avg_price, "Strategy Position Avg Price", display = display.data_window)
plot(fillState.rangeEntries, "Range Entries", display = display.data_window)
plot(fillState.rangeClosed, "Range Closed", display = display.data_window)
plot(fillState.rangeWins, "Range Wins", display = display.data_window)
plot(fillState.shockEntries, "Shock Entries", display = display.data_window)
plot(fillState.shockClosed, "Shock Closed", display = display.data_window)
plot(fillState.shockWins, "Shock Wins", display = display.data_window)
plot(previousExecutionPositionSize, "Previous Execution Position Size", display = display.data_window)
plot(currentPositionSize, "Current Strategy Position Size", display = display.data_window)
plot(fillState.pos, "FillState Direction", display = display.data_window)
plot(consistencyState, "Consistency State", display = display.data_window)
plot(directionReversed ? 1 : 0, "Direction Reversal Detected", display = display.data_window)
plot(fillState.consistencyRecoveryCount, "Consistency Recovery Count", display = display.data_window)
plot(fillState.trimRequested ? 1 : 0, "Pending Trim Fill", display = display.data_window)
plot(fillState.exitRequested ? 1 : 0, "Pending Full Exit Fill", display = display.data_window)
plot(fillState.latestClosedExitCode, "Latest Closed Entry ID Code", display = display.data_window)
plot(fillState.eventKind, "Fill Event Type", display = display.data_window)
plot(fillState.active ? 1 : 0, "Broker-synced Trade Active", display = display.data_window)
plot(fillState.partialTaken ? 1 : 0, "Broker-synced Partial Taken", display = display.data_window)
plot(fillState.shockZCandidates, "Shock Z Candidates", display = display.data_window)
plot(fillState.shockMoveCandidates, "Shock Move Candidates", display = display.data_window)
plot(fillState.shockEnvironmentPass, "Shock Environment Pass", display = display.data_window)
plot(fillState.shockDecelerationPass, "Shock Deceleration Pass", display = display.data_window)
plot(fillState.shockRejectionPass, "Shock Rejection Pass", display = display.data_window)
plot(fillState.shockSetups, "Shock Setups", display = display.data_window)
plot(fillState.shockConfirmedEntries, "Shock Confirmed Entries", display = display.data_window)


// ============================================================================
// Panel
// ============================================================================

var table panel = table.new(position.top_right, 2, 21, border_width = 1)

if showPanel and barstate.islast

    string envText = f_tr("禁做T", "No T")
    color envColor = color.gray

    if rangeEnvironment
        envText := "Range"
        envColor := color.aqua
    else if shockEnvironment
        envText := "Shock Only"
        envColor := color.purple

    bool consistencyError = consistencyState >= CONSISTENCY_STALE_ACTIVE_FLAT
    string stateText = consistencyError ? f_tr("状态错误", "STATE ERROR") : fillState.active and fillState.pos == 1 ? f_tr("T多", "Long") : fillState.active and fillState.pos == -1 ? f_tr("T空", "Short") : fillState.pendingEntry and fillState.pendingDir == 1 ? f_tr("待多头成交", "Pending Long") : fillState.pendingEntry and fillState.pendingDir == -1 ? f_tr("待空头成交", "Pending Short") : f_tr("空仓", "Flat")

    string brokerPositionText = currentPositionSize == 0.0 ? f_tr("空仓", "Flat") : currentPositionDir == 1 ? f_tr("多头 ", "Long ") + str.tostring(math.abs(currentPositionSize), "#.########") : f_tr("空头 ", "Short ") + str.tostring(math.abs(currentPositionSize), "#.########")
    string brokerAvgText = currentPositionSize == 0.0 ? "-" : str.tostring(strategy.position_avg_price, format.mintick)
    string fillStatePositionText = fillState.active and fillState.pos == 1 ? f_tr("多头", "Long") : fillState.active and fillState.pos == -1 ? f_tr("空头", "Short") : fillState.pendingEntry and fillState.pendingDir == 1 ? f_tr("待多头", "Pending Long") : fillState.pendingEntry and fillState.pendingDir == -1 ? f_tr("待空头", "Pending Short") : f_tr("空仓", "Flat")
    string consistencyText = f_consistencyName(consistencyState)
    color consistencyColor = consistencyError ? color.red : color.lime

    string setupText = f_tr("无", "None")

    if t.setupMode == 1 and t.setupDir == 1
        setupText := f_tr("R等T买", "Range→Long")
    else if t.setupMode == 2 and t.setupDir == 1
        setupText := f_tr("S等T买", "Shock→Long")
    else if t.setupMode == 1 and t.setupDir == -1
        setupText := f_tr("R等T空", "Range→Short")
    else if t.setupMode == 2 and t.setupDir == -1
        setupText := f_tr("S等T空", "Shock→Short")

    string hlText = na(halfLife) ? f_tr("无效", "n/a") : str.tostring(halfLife, "#.0")
    string shockText = str.tostring(shockMove, "#.00") + " ATR"
    string scoreText = str.tostring(regimeScore, "#")
    string modeText = tradeContextValid ? f_modeName(fillState.tradeMode) : fillState.pendingEntry ? f_modeName(fillState.pendingMode) : "-"
    string stopText = stopMode
    string phaseText = tradeContextValid ? fillState.exitRequested ? f_tr("等待全平成交", "Full exit pending") : fillState.trimRequested ? f_tr("等待T减成交", "Trim fill pending") : fillState.partialTaken ? f_tr("T减后", "Final phase") : f_tr("等待T减", "Trim phase") : fillState.pendingEntry ? f_tr("等待进场成交", "Entry pending") : "-"
    string entryText = not tradeContextValid ? "-" : str.tostring(fillState.entryPrice, format.mintick)
    string trimText = not tradeContextValid ? "-" : str.tostring(fillState.partialTarget, format.mintick)
    string finalText = not tradeContextValid ? "-" : str.tostring(fillState.finalTarget, format.mintick)
    string riskText = not tradeContextValid ? "-" : str.tostring(f_activeStop(fillState.pos), format.mintick)
    float testerProfitFactor = strategy.grossloss != 0.0 ? strategy.grossprofit / math.abs(strategy.grossloss) : na
    string testerPLText = str.tostring(strategy.netprofit, format.mintick) + " / DD " + str.tostring(strategy.max_drawdown, format.mintick) + " / PF " + (na(testerProfitFactor) ? "-" : str.tostring(testerProfitFactor, "#.00"))
    float testerWinRate = strategy.closedtrades > 0 ? strategy.wintrades / strategy.closedtrades * 100.0 : na
    string testerTradeText = str.tostring(strategy.closedtrades, "#") + " / " + (na(testerWinRate) ? "-" : str.tostring(testerWinRate, "#.0") + "%")
    float rangeWinRate = fillState.rangeClosed > 0 ? fillState.rangeWins / fillState.rangeClosed * 100.0 : na
    float shockWinRate = fillState.shockClosed > 0 ? fillState.shockWins / fillState.shockClosed * 100.0 : na
    string rangeStatsText = "E " + str.tostring(fillState.rangeEntries, "#") + " / C " + str.tostring(fillState.rangeClosed, "#") + " / W " + str.tostring(fillState.rangeWins, "#") + " (" + (na(rangeWinRate) ? "-" : str.tostring(rangeWinRate, "#.0") + "%") + ")"
    string shockStatsText = "E " + str.tostring(fillState.shockEntries, "#") + " / C " + str.tostring(fillState.shockClosed, "#") + " / W " + str.tostring(fillState.shockWins, "#") + " (" + (na(shockWinRate) ? "-" : str.tostring(shockWinRate, "#.0") + "%") + ")"

    table.cell(panel, 0, 0, SCRIPT_NAME + " v" + SCRIPT_VERSION)
    table.cell(panel, 1, 0, "15m")

    table.cell(panel, 0, 1, f_tr("环境", "Env"))
    table.cell(panel, 1, 1, envText, text_color = envColor)

    table.cell(panel, 0, 2, "Score")
    table.cell(panel, 1, 2, scoreText)

    table.cell(panel, 0, 3, f_tr("状态", "State"))
    table.cell(panel, 1, 3, stateText)

    table.cell(panel, 0, 4, "Setup")
    table.cell(panel, 1, 4, setupText)

    table.cell(panel, 0, 5, "Z")
    table.cell(panel, 1, 5, str.tostring(z, "#.00"))

    table.cell(panel, 0, 6, "Shock")
    table.cell(panel, 1, 6, shockText)

    table.cell(panel, 0, 7, "Half-Life")
    table.cell(panel, 1, 7, hlText)

    table.cell(panel, 0, 8, f_tr("模式", "Mode"))
    table.cell(panel, 1, 8, modeText)

    table.cell(panel, 0, 9, f_tr("阶段", "Phase"))
    table.cell(panel, 1, 9, phaseText)

    table.cell(panel, 0, 10, f_tr("成交均价", "Entry avg"))
    table.cell(panel, 1, 10, entryText)

    table.cell(panel, 0, 11, f_tr("T减 / T平", "Trim / Final"))
    table.cell(panel, 1, 11, trimText + " / " + finalText)

    table.cell(panel, 0, 12, "Risk")
    table.cell(panel, 1, 12, riskText + " (" + stopText + ")")

    table.cell(panel, 0, 13, f_tr("Tester 净利/回撤/PF", "Tester P&L/DD/PF"))
    table.cell(panel, 1, 13, testerPLText)

    table.cell(panel, 0, 14, f_tr("Tester 交易 / 胜率", "Tester trades / win"))
    table.cell(panel, 1, 14, testerTradeText)

    table.cell(panel, 0, 15, f_tr("Range 进场 / 已平 / 盈利", "Range entries / closed / wins"))
    table.cell(panel, 1, 15, rangeStatsText)

    table.cell(panel, 0, 16, f_tr("Shock 进场 / 已平 / 盈利", "Shock entries / closed / wins"))
    table.cell(panel, 1, 16, shockStatsText)

    table.cell(panel, 0, 17, f_tr("Broker 仓位", "Broker Position"))
    table.cell(panel, 1, 17, brokerPositionText)

    table.cell(panel, 0, 18, f_tr("Broker 均价", "Broker Avg Price"))
    table.cell(panel, 1, 18, brokerAvgText)

    table.cell(panel, 0, 19, f_tr("FillState 仓位", "FillState Position"))
    table.cell(panel, 1, 19, fillStatePositionText)

    table.cell(panel, 0, 20, f_tr("一致性", "Consistency"))
    table.cell(panel, 1, 20, consistencyText, text_color = consistencyColor)


if not showPanel and barstate.islast
    table.clear(panel, 0, 0, 1, 20)


// ============================================================================
// Alerts
// ============================================================================

if setupEvent
    string setupEventName = setupEventMode == 2 ? "Shock Setup" : "Range Setup"
    alert(f_orderMessage(setupEventDir, setupEventName, setupEventMode, close), alert.freq_all)

if entryEvent
    alert(f_orderMessage(entryEventDir, "Entry Fill", eventMode, eventPrice), alert.freq_all)

if partialEvent
    alert(f_orderMessage(partialEventDir, "Trim", eventMode, eventPrice), alert.freq_all)

    if moveStopToBE
        alert(f_orderMessage(partialEventDir, "Breakeven Armed", eventMode, eventPrice), alert.freq_all)

if exitEvent
    alert(f_orderMessage(exitEventDir, f_exitName(exitReason), eventMode, eventPrice), alert.freq_all)
