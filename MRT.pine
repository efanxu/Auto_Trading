//@version=6
//@strategy_alert_message {{strategy.order.alert_message}} | fill={{strategy.order.price}}
// This Pine Script® code is subject to the terms of the Mozilla Public License 2.0 at https://mozilla.org/MPL/2.0/
// © Jasxu · TradingView: https://www.tradingview.com/u/Jasxu/
// GitHub: https://github.com/Ye-Yu-Mo
strategy("MR-T Strategy", shorttitle = "MR-T v3", overlay = true, pyramiding = 0, default_qty_type = strategy.percent_of_equity, default_qty_value = 100, commission_type = strategy.commission.percent, commission_value = 0.03, slippage = 0, process_orders_on_close = true, calc_on_order_fills = true, calc_on_every_tick = false, margin_long = 0, margin_short = 0, max_labels_count = 500)

// ============================================================================
// Mean Reversion T (MR-T) · Strategy v3.3.1
//
// 推荐周期 / Recommended timeframe : 15 分钟 (15m) —— 脚本内强制校验
//
// 双引擎 / Dual Engine
//   1. Range Reversion   市场适合震荡回归 → 温和 Z 偏离即可观察
//   2. Shock Reversal    市场不一定横盘 → 异常冲击 + 减速/拒绝 + 回归确认
// 共同保护 / Guard        Hard Trend Veto (1H + 15m 斜率与 Efficiency Ratio)
// 生命周期 / Lifecycle    观察 → T买/T空 → T减 → T平
// 异常退出 / Exits        T止损 / 趋势失效 / T超时 / T保本
// 架构 / Architecture     MRLogicState 决策 → Broker intent → MRBrokerState 执行诊断
//
// 定位 / Scope: TradingView strategy,用于 Strategy Tester 回测,不构成投资建议。
// confirmed-close 决策 → 当前 K 线收盘的 Strategy Tester 市价成交;
// 换品种/周期前请重新评估全部参数。
//
// 版本 / Version: v3.3.1 —— V2 Logic-State Parity Strategy 回测版本。变更见 CHANGELOG.md。
// ============================================================================


// ============================================================================
// ⑫ 语言与版本 / ⑫ Language & Version
// ============================================================================
// 运行时 UI(面板 / 图表标签 / 报错)随 lang 切换中英文。
// 注意:Pine 的 input 标题/分组、plotshape 的 text 都是编译期 const string,
// 无法用运行时变量切换语言:输入项标签保持中文。策略 alert() 与 order
// alert_message 使用运行时字符串,包含实际事件、方向、模式和成交占位符。

lang = input.string("zh", "语言 / Language", options = ["zh", "en"], group = "⑫ 语言与版本 / Language & Version")

f_tr(simple string zh, simple string en) =>
    lang == "zh" ? zh : en

string SCRIPT_NAME = "MR-T"
string SCRIPT_VERSION = "3.3.1"


// ============================================================================
// ① 交易方向
// ============================================================================

allowLong = input.bool(true, "允许T买", group = "① 交易方向")
allowShort = input.bool(true, "允许T空", group = "① 交易方向")


// ============================================================================
// ② 均值与 Z-score
// ============================================================================

meanLen = input.int(32, "15m 局部均值 EMA", minval = 10, group = "② 均值与Z-score")
zLen = input.int(32, "Z-score 周期", minval = 10, group = "② 均值与Z-score")

rangeEntryZ = input.float(1.65, "Range模式观察 Z", minval = 1.0, step = 0.05, group = "② 均值与Z-score")
shockEntryZ = input.float(2.00, "Shock模式观察 Z", minval = 1.2, step = 0.05, group = "② 均值与Z-score")

rangePartialZ = input.float(0.80, "Range T减目标 Z", minval = 0.10, step = 0.05, group = "② 均值与Z-score")
rangeExitZ = input.float(0.25, "Range T平目标 Z", minval = 0.0, step = 0.05, group = "② 均值与Z-score")

shockPartialZ = input.float(1.00, "Shock T减目标 Z", minval = 0.10, step = 0.05, group = "② 均值与Z-score")
shockExitZ = input.float(0.50, "Shock T平目标 Z", minval = 0.0, step = 0.05, group = "② 均值与Z-score")

stopZ = input.float(3.25, "极端统计失效 Z", minval = 2.2, step = 0.25, group = "② 均值与Z-score")


// ============================================================================
// ③ 1H 市场状态
// ============================================================================

htfTf = input.timeframe("60", "市场状态周期", group = "③ 1H 市场状态")
htfMeanLen = input.int(20, "1H 均值 EMA", minval = 5, group = "③ 1H 市场状态")
htfSlopeLookback = input.int(4, "1H 斜率周期", minval = 1, group = "③ 1H 市场状态")

idealHtfSlope = input.float(0.10, "1H 理想最大斜率 ATR/Bar", minval = 0.01, step = 0.01, group = "③ 1H 市场状态")

htfERLen = input.int(10, "1H Efficiency Ratio 周期", minval = 3, group = "③ 1H 市场状态")
idealHtfER = input.float(0.50, "1H 理想最大 ER", minval = 0.10, maxval = 1.0, step = 0.05, group = "③ 1H 市场状态")


// ============================================================================
// ④ 15m 市场状态
// ============================================================================

localSlopeLookback = input.int(8, "15m 斜率周期", minval = 2, group = "④ 15m 市场状态")
idealLocalSlope = input.float(0.12, "15m 理想最大斜率 ATR/Bar", minval = 0.01, step = 0.01, group = "④ 15m 市场状态")

localERLen = input.int(16, "15m Efficiency Ratio 周期", minval = 3, group = "④ 15m 市场状态")
idealLocalER = input.float(0.60, "15m 理想最大 ER", minval = 0.10, maxval = 1.0, step = 0.05, group = "④ 15m 市场状态")


// ============================================================================
// ⑤ Regime Score
// ============================================================================

rangeMinScore = input.float(50.0, "Range模式最低环境分", minval = 0, maxval = 100, step = 1, group = "⑤ Regime Score")
shockMinScore = input.float(45.0, "Shock模式最低环境分", minval = 0, maxval = 100, step = 1, group = "⑤ Regime Score")

regimeSmoothLen = input.int(3, "环境分平滑周期", minval = 1, maxval = 8, group = "⑤ Regime Score")


// ============================================================================
// ⑥ Hard Trend Veto
// ============================================================================

vetoHtfSlope = input.float(0.18, "1H 趋势禁做斜率", minval = 0.05, step = 0.01, group = "⑥ Hard Trend Veto")
vetoLocalSlope = input.float(0.23, "15m 趋势禁做斜率", minval = 0.05, step = 0.01, group = "⑥ Hard Trend Veto")

vetoHtfER = input.float(0.75, "1H 趋势禁做 ER", minval = 0.50, maxval = 1.0, step = 0.01, group = "⑥ Hard Trend Veto")
vetoLocalER = input.float(0.80, "15m 趋势禁做 ER", minval = 0.50, maxval = 1.0, step = 0.01, group = "⑥ Hard Trend Veto")


// ============================================================================
// ⑦ Shock Engine
// ============================================================================

shockLookback = input.int(2, "Shock 检测 K 数", minval = 1, maxval = 4, group = "⑦ Shock Engine")
minShockATR = input.float(0.80, "最小 Shock 强度 ATR", minval = 0.20, step = 0.05, group = "⑦ Shock Engine")

requireShockDeceleration = input.bool(true, "Shock要求冲击减速", group = "⑦ Shock Engine")
decelerationRatio = input.float(0.85, "Shock减速比例", minval = 0.30, maxval = 1.20, step = 0.05, group = "⑦ Shock Engine")

requireRejection = input.bool(true, "Shock要求拒绝/反向K线", group = "⑦ Shock Engine")

minWickRatio = input.float(0.30, "最低拒绝影线比例", minval = 0.0, maxval = 0.8, step = 0.05, group = "⑦ Shock Engine")


// ============================================================================
// ⑧ Half-Life / Time Stop
// ============================================================================

halfLifeLookback = input.int(80, "Half-Life 样本长度", minval = 30, group = "⑧ Half-Life")

timeStopMultiplier = input.float(3.0, "Time Stop = Half-Life ×", minval = 1.0, step = 0.25, group = "⑧ Half-Life")

minTimeStopBars = input.int(8, "最短 Time Stop", minval = 2, group = "⑧ Half-Life")
maxTimeStopBars = input.int(40, "最长 Time Stop", minval = 8, group = "⑧ Half-Life")
fallbackTimeStopBars = input.int(24, "Half-Life无效时 Time Stop", minval = 4, group = "⑧ Half-Life")


// ============================================================================
// ⑨ Setup / Confirmation
// ============================================================================

rangeSetupBars = input.int(16, "Range Setup 有效 K 数", minval = 2, maxval = 48, group = "⑨ 入场确认")
shockSetupBars = input.int(8, "Shock Setup 有效 K 数", minval = 2, maxval = 24, group = "⑨ 入场确认")

requireCandleConfirm = input.bool(true, "要求K线方向确认", group = "⑨ 入场确认")
requireBandReclaim = input.bool(true, "要求价格重新进入Z区间", group = "⑨ 入场确认")

cooldownBars = input.int(3, "退出后冷却 K 数", minval = 0, maxval = 24, group = "⑨ 入场确认")
trimPct = input.float(50.0, "T减退出仓位 (%)", minval = 1.0, maxval = 99.0, step = 1.0, group = "⑨ 入场确认")


// ============================================================================
// ⑩ 风险控制
// ============================================================================

atrLen = input.int(14, "ATR 周期", minval = 1, group = "⑩ 风险控制")

hardStopATR = input.float(2.50, "ATR 紧急止损", minval = 0.50, step = 0.25, group = "⑩ 风险控制")

stopMode = input.string("Balanced", "止损模式", options = ["Tight", "Balanced", "Loose"], group = "⑩ 风险控制")

balancedWeight = input.float(0.50, "Balanced统计止损权重", minval = 0.0, maxval = 1.0, step = 0.05, group = "⑩ 风险控制")

moveStopToBE = input.bool(true, "T减后启用保本保护", group = "⑩ 风险控制")

// strategy() 只能接受编译期的 commission/slippage 默认值;这两个输入用于
// BE 价格估算,应与 Strategy Tester -> Properties 中的设置保持一致。
commissionBps = input.float(3.0, "Strategy Tester 手续费(bp/边)", minval = 0.0, step = 0.5, group = "⑩ 风险控制")
slippageTicks = input.int(0, "Strategy Tester 滑点(ticks/边)", minval = 0, group = "⑩ 风险控制")


// ============================================================================
// ⑪ 显示
// ============================================================================

showBands = input.bool(true, "显示均值回归区间", group = "⑪ 显示")
showBackground = input.bool(true, "显示做T环境", group = "⑪ 显示")
showSetup = input.bool(true, "显示观察信号", group = "⑪ 显示")
showPanel = input.bool(true, "显示状态面板", group = "⑪ 显示")
showTradeLevels = input.bool(true, "显示本轮目标/风险", group = "⑪ 显示")


// ============================================================================
// 参数检查
// ============================================================================

if shockEntryZ <= rangeEntryZ
    runtime.error("Shock模式 Z 必须高于 Range模式 Z。/ Shock mode Z must be higher than Range mode Z.")

if rangeExitZ >= rangePartialZ
    runtime.error("Range T平目标必须小于 Range T减目标。/ Range exit Z must be below Range partial Z.")

if shockExitZ >= shockPartialZ
    runtime.error("Shock T平目标必须小于 Shock T减目标。/ Shock exit Z must be below Shock partial Z.")

if rangePartialZ >= rangeEntryZ
    runtime.error("Range T减目标必须小于 Range观察 Z。/ Range partial Z must be below Range entry Z.")

if shockPartialZ >= shockEntryZ
    runtime.error("Shock T减目标必须小于 Shock观察 Z。/ Shock partial Z must be below Shock entry Z.")

if stopZ <= shockEntryZ
    runtime.error("Stop Z 必须高于 Shock Entry Z。/ Stop Z must be above Shock entry Z.")


// ============================================================================
// 周期保护
// ============================================================================

chartSeconds = timeframe.in_seconds(timeframe.period)
requiredSeconds = timeframe.in_seconds("15")
htfSeconds = timeframe.in_seconds(htfTf)

if chartSeconds != requiredSeconds
    runtime.error("Mean Reversion T 设计用于15分钟图。/ Designed for the 15-minute chart.")

if htfSeconds <= chartSeconds
    runtime.error("高周期必须高于15分钟,默认使用60分钟。/ Higher timeframe must be above 15m. Default is 60m.")


// ============================================================================
// Helper Functions
// ============================================================================

// Kaufman Efficiency Ratio, 路径用平均单根位移近似。
f_er(int length) =>
    float absMove = math.abs(ta.change(close))
    float avgMove = ta.sma(absMove, length)
    float path = avgMove * length
    float net = math.abs(close - close[length])
    path > 0.0 ? net / path : 0.0

// 上一根(高周期)已确认的 ER —— 防重绘。需在 request.security 内求值。
f_erPrev(int length) =>
    f_er(length)[1]

// 归一化斜率:EMA 位移 / ATR / lookback。
f_slopeATR(int emaLength, int atrLength, int lookback) =>
    float m = ta.ema(close, emaLength)
    float a = math.max(ta.atr(atrLength), syminfo.mintick)
    (m - m[lookback]) / a / lookback

// 上一根(高周期)已确认的斜率 —— 防重绘。需在 request.security 内求值。
f_slopeATRPrev(int emaLength, int atrLength, int lookback) =>
    f_slopeATR(emaLength, atrLength, lookback)[1]

// 单维度环境分:25 分满分,随 |value|/ideal 衰减,截断到 [0, 25]。
f_score(float value, float idealLimit) =>
    float ratio = idealLimit > 0.0 ? math.abs(value) / idealLimit : 10.0
    float rawScore = 25.0 * (1.0 - ratio)
    float floorScore = math.max(rawScore, 0.0)
    math.min(floorScore, 25.0)


// ============================================================================
// Mean / ATR
// ============================================================================

mean15 = ta.ema(close, meanLen)
atr15 = ta.atr(atrLen)
safeATR = math.max(atr15, syminfo.mintick)


// ============================================================================
// Residual / Z-score
// ============================================================================

residual = close - mean15
residualStd = ta.stdev(residual, zLen)
safeStd = math.max(nz(residualStd), syminfo.mintick)
z = residual / safeStd


// ============================================================================
// 动态区间
// ============================================================================

upperRangeBand = mean15 + rangeEntryZ * safeStd
lowerRangeBand = mean15 - rangeEntryZ * safeStd

upperShockBand = mean15 + shockEntryZ * safeStd
lowerShockBand = mean15 - shockEntryZ * safeStd

upperStopBand = mean15 + stopZ * safeStd
lowerStopBand = mean15 - stopZ * safeStd


// ============================================================================
// Local Regime (15m)
// ============================================================================

localSlopeATR = (mean15 - mean15[localSlopeLookback]) / safeATR / localSlopeLookback
localER = f_er(localERLen)


// ============================================================================
// Confirmed 1H Regime (防重绘:取上一根已确认的 1H bar 值)
// ============================================================================

htfSlopeATR = request.security(syminfo.tickerid, htfTf, f_slopeATRPrev(htfMeanLen, atrLen, htfSlopeLookback), lookahead = barmerge.lookahead_on)
htfER = request.security(syminfo.tickerid, htfTf, f_erPrev(htfERLen), lookahead = barmerge.lookahead_on)


// ============================================================================
// Regime Score
// ============================================================================

htfSlopeScore = f_score(htfSlopeATR, idealHtfSlope)
htfERScore = f_score(htfER, idealHtfER)
localSlopeScore = f_score(localSlopeATR, idealLocalSlope)
localERScore = f_score(localER, idealLocalER)

rawRegimeScore = htfSlopeScore + htfERScore + localSlopeScore + localERScore
regimeScore = ta.sma(rawRegimeScore, regimeSmoothLen)


// ============================================================================
// Hard Trend Veto
// ============================================================================

htfSlopeVeto = math.abs(htfSlopeATR) >= vetoHtfSlope
localSlopeVeto = math.abs(localSlopeATR) >= vetoLocalSlope
htfERVeto = htfER >= vetoHtfER
localERVeto = localER >= vetoLocalER

hardTrendVeto = htfSlopeVeto or localSlopeVeto or htfERVeto or localERVeto

rangeEnvironment = not hardTrendVeto and regimeScore >= rangeMinScore
shockEnvironment = not hardTrendVeto and regimeScore >= shockMinScore


// ============================================================================
// Shock Detection
// ============================================================================
// Shock 强度:最近 N 根走了多少 ATR。

shockMove = (close - close[shockLookback]) / safeATR
shockUp = shockMove >= minShockATR
shockDown = shockMove <= -minShockATR

// 当前冲击 vs 前一段冲击:开始减弱 → 更像过冲结束。
previousShockMove = (close[shockLookback] - close[shockLookback * 2]) / safeATR
shockDecelerating = math.abs(shockMove) <= math.abs(previousShockMove) * decelerationRatio
decelerationOK = not requireShockDeceleration or shockDecelerating


// ============================================================================
// Candle / Wick Rejection
// ============================================================================

barRange = math.max(high - low, syminfo.mintick)

lowerWick = math.min(open, close) - low
upperWick = high - math.max(open, close)

lowerWickRatio = lowerWick / barRange
upperWickRatio = upperWick / barRange

bullishCandle = close > open
bearishCandle = close < open

longRejection = bullishCandle or lowerWickRatio >= minWickRatio
shortRejection = bearishCandle or upperWickRatio >= minWickRatio

longRejectionOK = not requireRejection or longRejection
shortRejectionOK = not requireRejection or shortRejection


// ============================================================================
// Half-Life
// ============================================================================
// 对 d(residual) ~ beta * residual[-1] 回归,Half-Life = -ln(2) / beta。
// beta 为正(动量)或无效时,退化到 fallbackTimeStopBars。

residualLag = residual[1]
residualDelta = residual - residual[1]

hlCorr = ta.correlation(residualDelta, residualLag, halfLifeLookback)
hlDeltaStd = ta.stdev(residualDelta, halfLifeLookback)
hlLagStd = ta.stdev(residualLag, halfLifeLookback)

bool betaOK = not na(hlCorr) and not na(hlDeltaStd) and not na(hlLagStd) and hlLagStd > 0.0

float hlBeta = na

if betaOK
    hlBeta := hlCorr * hlDeltaStd / hlLagStd

float halfLife = na

if not na(hlBeta) and hlBeta < -0.000001
    halfLife := -math.log(2.0) / hlBeta


// ============================================================================
// 全局 Cross
// ============================================================================

zCrossOverNegRange = ta.crossover(z, -rangeEntryZ)
zCrossUnderPosRange = ta.crossunder(z, rangeEntryZ)

zCrossOverNegShock = ta.crossover(z, -shockEntryZ)
zCrossUnderPosShock = ta.crossunder(z, shockEntryZ)


// ============================================================================
// State
// ============================================================================
// MRLogicState 是 V2.0.0 MRState 的直接逻辑基线。所有字段都属于交易逻辑
// 时间轴;它们不读取 strategy.position_*、closedtrades 或任何 Broker fill 状态。
// varip 让同一 bar 的 fill recalculation 保留已经产生的逻辑事件。

type MRLogicState
    varip int    pos           = 0     // 0 空仓 / +1 多头 / -1 空头
    varip bool   partialTaken  = false
    varip int    setupBar      = na    // 活跃 Setup 的 bar_index
    varip int    setupDir      = 0     // Setup 方向:+1 / -1
    varip int    setupMode     = 0     // 0 无 / 1 Range / 2 Shock
    varip int    entryBar      = na
    varip float  entryPrice    = na
    varip float  mean          = na
    varip float  std           = na
    varip float  atr           = na
    varip float  partialTarget = na
    varip float  finalTarget   = na
    varip float  baseStop      = na
    varip int    timeStop      = na
    varip int    tradeMode     = 0     // 0 无 / 1 Range / 2 Shock
    varip float  cost          = 0.0   // V2 往返成本(价格单位)
    varip int    lastExitBar   = na
    varip int    eventKind     = 0     // 0 无 / 1 进场 / 2 T减 / 3 退出
    varip int    eventDir      = 0     // 事件方向:+1 / -1
    varip int    eventReason   = 0     // 退出原因(仅 eventKind == 3)
    varip int    tradeCount    = 0
    varip float  sumPnlATR     = 0.0
    varip float  lastPnlATR    = na
    varip float  lastPnlPct    = na

    // Logic-only decision diagnostics; these never gate the V2 lifecycle.
    varip int    trimDecisionBar = na
    varip int    exitDecisionBar = na

    // Rollback-safe current-bar logic event snapshot.
    varip int    logicEventBar    = na
    varip int    logicEventKind   = 0
    varip int    logicEventDir    = 0
    varip int    logicEventReason = 0
    varip int    logicEventMode   = 0
    varip float  logicEventPrice  = na

var MRLogicState logic = MRLogicState.new()

// Broker state is execution-only. It may remember order intents and actual
// fills, but it never owns partialTaken, entryBar, lastExitBar, activeStop, or
// any other V2 lifecycle field.
type MRBrokerState
    varip bool   trackerReady = false
    varip float  previousPositionSize = na
    varip int    observedClosedTrades = 0

    // Broker order intents copied from a Logic Event.
    varip bool   entryIntentPending = false
    varip int    entryIntentDir = 0
    varip int    entryIntentMode = 0
    varip int    entryIntentBar = na
    varip bool   trimIntentPending = false
    varip int    trimIntentDir = 0
    varip int    trimIntentMode = 0
    varip int    trimIntentBar = na
    varip bool   fullExitIntentPending = false
    varip int    fullExitIntentDir = 0
    varip int    fullExitIntentMode = 0
    varip int    fullExitIntentReason = 0
    varip int    fullExitIntentBar = na

    // Actual Broker Emulator facts and fill diagnostics.
    varip float  brokerEntryPrice = na
    varip int    entryFillBar = na
    varip int    trimFillBar = na
    varip int    fullExitFillBar = na
    varip int    fillEventBar = na
    varip int    fillEventKind = 0
    varip int    fillEventDir = 0
    varip int    fillEventReason = 0
    varip float  fillEventPrice = na
    varip float  netProfitAtEntry = na

    // Broker-only consistency recovery and auxiliary execution statistics.
    varip bool   recoveryPending = false
    varip bool   recoveryClosePlaced = false
    varip int    recoveryState = 0
    varip int    recoveryCount = 0
    varip int    latestClosedExitCode = 0
    varip int    rangeEntries = 0
    varip int    rangeClosed = 0
    varip int    rangeWins = 0
    varip int    shockEntries = 0
    varip int    shockClosed = 0
    varip int    shockWins = 0

    // Confirmed-close Shock funnel diagnostics.
    varip int    shockZCandidates = 0
    varip int    shockMoveCandidates = 0
    varip int    shockEnvironmentPass = 0
    varip int    shockDecelerationPass = 0
    varip int    shockRejectionPass = 0
    varip int    shockSetups = 0
    varip int    shockConfirmedEntries = 0

var MRBrokerState broker = MRBrokerState.new()

// Setup labels have their own rollback-safe snapshot. T labels use the
// persistent Logic Event fields above.
varip int logicSetupEventBar = na
varip int logicSetupEventDir = 0
varip int logicSetupEventMode = 0

bool setupEvent = logicSetupEventBar == bar_index
int setupEventDir = logicSetupEventDir
int setupEventMode = logicSetupEventMode

bool entryEvent = false
int entryEventDir = 0
bool partialEvent = false
int partialEventDir = 0
bool exitEvent = false
int exitEventDir = 0
int exitReason = 0

// Only a new bar clears the Logic Event. In particular, a same-bar fill
// recalculation must render the exact same event instead of erasing it.
if na(logic.logicEventBar) or bar_index != logic.logicEventBar
    logic.logicEventBar := bar_index
    logic.logicEventKind := 0
    logic.logicEventDir := 0
    logic.logicEventReason := 0
    logic.logicEventMode := 0
    logic.logicEventPrice := na
    logic.eventKind := 0
    logic.eventDir := 0
    logic.eventReason := 0

if na(logicSetupEventBar) or bar_index != logicSetupEventBar
    logicSetupEventBar := na
    logicSetupEventDir := 0
    logicSetupEventMode := 0

// 退出原因枚举
int R_STOP  = 1
int R_TREND = 2
int R_TIME  = 3
int R_FINAL = 4
int R_BE    = 5
int R_STATE_RECOVERY = 6

// f_logicManage() result codes. State mutation remains the source of truth; the
// return value is a single int for diagnostics and future callers.
int MANAGE_NONE     = 0
int MANAGE_STOP_BE  = 1
int MANAGE_TREND    = 2
int MANAGE_TIMEOUT  = 3
int MANAGE_TRIM     = 4
int MANAGE_FINAL    = 5

// Broker consistency classifier. These states describe execution diagnostics;
// none of them is allowed to rewrite the V2 Logic State.
int CONSISTENCY_OK_FLAT = 0
int CONSISTENCY_OK_LONG = 1
int CONSISTENCY_OK_SHORT = 2
int CONSISTENCY_PENDING_ENTRY = 3
int CONSISTENCY_STALE_ACTIVE_FLAT = 4
int CONSISTENCY_DIRECTION_MISMATCH = 5
int CONSISTENCY_ORPHAN_BROKER = 6
int CONSISTENCY_DIRECT_REVERSAL = 7
int CONSISTENCY_STALE_PENDING = 8
int CONSISTENCY_INVALID_CONTEXT = 9
int CONSISTENCY_PENDING_TRIM = 10
int CONSISTENCY_PENDING_EXIT = 11

f_consistencyName(int state) =>
    state == CONSISTENCY_OK_FLAT ? "OK_FLAT" : state == CONSISTENCY_OK_LONG ? "OK_LONG" : state == CONSISTENCY_OK_SHORT ? "OK_SHORT" : state == CONSISTENCY_PENDING_ENTRY ? "PENDING_ENTRY" : state == CONSISTENCY_STALE_ACTIVE_FLAT ? "STALE_ACTIVE_FLAT" : state == CONSISTENCY_DIRECTION_MISMATCH ? "DIRECTION_MISMATCH" : state == CONSISTENCY_ORPHAN_BROKER ? "ORPHAN_BROKER" : state == CONSISTENCY_DIRECT_REVERSAL ? "DIRECT_REVERSAL" : state == CONSISTENCY_STALE_PENDING ? "STALE_PENDING" : state == CONSISTENCY_PENDING_TRIM ? "PENDING_TRIM" : state == CONSISTENCY_PENDING_EXIT ? "PENDING_EXIT" : "INVALID_CONTEXT"

// --------------------------------------------------------------------------
// Broker transition detection and fill synchronization.
// This section observes Strategy Tester facts and never mutates MRLogicState.
float currentPositionSize = strategy.position_size
bool trackerWasReady = broker.trackerReady
float previousExecutionPositionSize = broker.previousPositionSize
int closedTradesNow = strategy.closedtrades

if not trackerWasReady
    broker.previousPositionSize := currentPositionSize
    broker.observedClosedTrades := closedTradesNow
    broker.trackerReady := true

bool positionSampleReady = trackerWasReady and not na(previousExecutionPositionSize)
bool positionEntered = positionSampleReady and previousExecutionPositionSize == 0.0 and currentPositionSize != 0.0
bool positionClosed = positionSampleReady and previousExecutionPositionSize != 0.0 and currentPositionSize == 0.0
bool sameDirectionPosition = positionSampleReady and previousExecutionPositionSize != 0.0 and currentPositionSize != 0.0 and previousExecutionPositionSize * currentPositionSize > 0.0
bool positionReduced = sameDirectionPosition and math.abs(currentPositionSize) < math.abs(previousExecutionPositionSize)
bool positionChanged = positionSampleReady and currentPositionSize != previousExecutionPositionSize
bool isFillSynchronizationExecution = positionChanged
int previousPositionDir = previousExecutionPositionSize > 0.0 ? 1 : previousExecutionPositionSize < 0.0 ? -1 : 0
int currentPositionDir = currentPositionSize > 0.0 ? 1 : currentPositionSize < 0.0 ? -1 : 0

// Re-read the broker transition once per execution. A position change marks a
// fill synchronization execution; it is never a Logic decision trigger.
bool hasNewClosedTrade = positionSampleReady and closedTradesNow > broker.observedClosedTrades
string latestClosedExitId = hasNewClosedTrade ? strategy.closedtrades.exit_id(closedTradesNow - 1) : ""
float latestClosedExitPrice = hasNewClosedTrade ? strategy.closedtrades.exit_price(closedTradesNow - 1) : close

if hasNewClosedTrade
    broker.latestClosedExitCode := latestClosedExitId == "MR-L" ? 1 : latestClosedExitId == "MR-S" ? 2 : latestClosedExitId == "" ? 0 : 3

bool entryFilled = positionEntered and broker.entryIntentPending and broker.entryIntentDir == currentPositionDir
bool trimFilled = positionReduced and broker.trimIntentPending and broker.trimIntentDir == currentPositionDir
bool fullExitFilled = positionClosed and broker.fullExitIntentPending

// Fill transitions only update MRBrokerState. In particular, a Trim fill does
// not set logic.partialTaken; that mutation already happened on the Logic bar.
if entryFilled
    broker.entryIntentPending := false
    broker.brokerEntryPrice := strategy.position_avg_price
    broker.entryFillBar := bar_index
    broker.fillEventBar := bar_index
    broker.netProfitAtEntry := strategy.netprofit
    broker.fillEventKind := 1
    broker.fillEventDir := currentPositionDir
    broker.fillEventReason := 0
    broker.fillEventPrice := broker.brokerEntryPrice

    if broker.entryIntentMode == 1
        broker.rangeEntries += 1
    else
        broker.shockEntries += 1

if trimFilled
    broker.trimIntentPending := false
    broker.trimFillBar := bar_index
    broker.fillEventBar := bar_index
    broker.fillEventKind := 2
    broker.fillEventDir := currentPositionDir
    broker.fillEventReason := 0
    broker.fillEventPrice := latestClosedExitPrice

if fullExitFilled
    int finishedBrokerMode = broker.fullExitIntentMode
    float tradeNetProfit = na(broker.netProfitAtEntry) ? 0.0 : strategy.netprofit - broker.netProfitAtEntry
    bool winningBrokerTrade = tradeNetProfit > 0.0

    broker.fullExitIntentPending := false
    broker.fullExitFillBar := bar_index
    broker.fillEventBar := bar_index
    broker.fillEventKind := 3
    broker.fillEventDir := broker.fullExitIntentDir
    broker.fillEventReason := broker.fullExitIntentReason
    broker.fillEventPrice := latestClosedExitPrice

    if finishedBrokerMode == 1
        broker.rangeClosed += 1
        if winningBrokerTrade
            broker.rangeWins += 1
    else if finishedBrokerMode == 2
        broker.shockClosed += 1
        if winningBrokerTrade
            broker.shockWins += 1

    broker.netProfitAtEntry := na

// Consistency classification is diagnostic and recovery-only. It cannot gate
// or rewrite the V2 setup, entry, management, cooldown, or Logic Event path.
bool logicHasPosition = logic.pos != 0
bool directionReversed = positionSampleReady and previousExecutionPositionSize * currentPositionSize < 0.0
bool brokerDirectionMismatch = currentPositionSize != 0.0 and logicHasPosition and currentPositionDir != logic.pos
bool pendingDirectionMismatch = currentPositionSize != 0.0 and broker.entryIntentPending and currentPositionDir != broker.entryIntentDir
bool stalePendingEntry = currentPositionSize != 0.0 and broker.entryIntentPending and not positionEntered
bool orphanBrokerPosition = currentPositionSize != 0.0 and not logicHasPosition and not broker.entryIntentPending and not broker.fullExitIntentPending
bool staleLogicActiveFlat = currentPositionSize == 0.0 and logicHasPosition and not broker.entryIntentPending and not broker.fullExitIntentPending
bool unexpectedSameDirectionReduction = positionReduced and not trimFilled
bool unexpectedSameDirectionIncrease = sameDirectionPosition and math.abs(currentPositionSize) > math.abs(previousExecutionPositionSize)

int consistencyState = currentPositionSize == 0.0 ? CONSISTENCY_OK_FLAT : CONSISTENCY_ORPHAN_BROKER
bool consistencyRecoveryRequired = false
bool recoveryResolved = currentPositionSize == 0.0 and logic.pos == 0 and not broker.entryIntentPending and not broker.fullExitIntentPending

if broker.recoveryPending
    consistencyState := broker.recoveryState

    if recoveryResolved
        broker.recoveryPending := false
        broker.recoveryClosePlaced := false
        consistencyState := CONSISTENCY_OK_FLAT
    else
        consistencyRecoveryRequired := true
else if directionReversed
    consistencyState := CONSISTENCY_DIRECT_REVERSAL
    consistencyRecoveryRequired := true
else if brokerDirectionMismatch or pendingDirectionMismatch
    consistencyState := CONSISTENCY_DIRECTION_MISMATCH
    consistencyRecoveryRequired := true
else if staleLogicActiveFlat
    consistencyState := CONSISTENCY_STALE_ACTIVE_FLAT
    consistencyRecoveryRequired := true
else if unexpectedSameDirectionReduction or unexpectedSameDirectionIncrease
    consistencyState := CONSISTENCY_INVALID_CONTEXT
    consistencyRecoveryRequired := true
else if stalePendingEntry
    consistencyState := CONSISTENCY_STALE_PENDING
    consistencyRecoveryRequired := true
else if orphanBrokerPosition
    consistencyState := CONSISTENCY_ORPHAN_BROKER
    consistencyRecoveryRequired := true
else if fullExitFilled
    consistencyState := CONSISTENCY_OK_FLAT
else if broker.fullExitIntentPending
    consistencyState := CONSISTENCY_PENDING_EXIT
else if trimFilled or broker.trimIntentPending
    consistencyState := CONSISTENCY_PENDING_TRIM
else if entryFilled or broker.entryIntentPending
    consistencyState := CONSISTENCY_PENDING_ENTRY
else if currentPositionSize != 0.0 and logicHasPosition and currentPositionDir == logic.pos
    consistencyState := currentPositionDir == 1 ? CONSISTENCY_OK_LONG : CONSISTENCY_OK_SHORT

// Recovery is an execution-layer safety action. It never resets Logic State.
if consistencyRecoveryRequired
    bool startingRecovery = not broker.recoveryPending

    if startingRecovery
        broker.recoveryCount += 1
        broker.recoveryState := consistencyState
        broker.recoveryClosePlaced := false
        broker.entryIntentPending := false
        broker.trimIntentPending := false
        broker.fullExitIntentPending := false
        strategy.cancel_all()

    broker.recoveryPending := true

    if currentPositionSize != 0.0 and not broker.recoveryClosePlaced
        string recoveryDirection = currentPositionDir == 1 ? "Long" : "Short"
        strategy.close_all(comment = "MR-T Broker Recovery", alert_message = "MR-T|direction=" + recoveryDirection + "|event=BROKER RECOVERY|price=" + str.tostring(close, format.mintick))
        broker.recoveryClosePlaced := true

// Fill recalculation and confirmed-close decision execution are separate.
bool allowBarCloseDecision = barstate.isconfirmed and not isFillSynchronizationExecution

// 冷却
int barsSinceExit = 100000

if not na(logic.lastExitBar)
    barsSinceExit := bar_index - logic.lastExitBar

int requiredCooldown = math.max(cooldownBars, 1)
bool canEnter = na(logic.lastExitBar) or barsSinceExit >= requiredCooldown


// ============================================================================
// 创建 Setup (Shock 优先于 Range;方向反转允许替换对侧 Setup)
// ============================================================================

bool longShockZCandidate = allowLong and z <= -shockEntryZ
bool shortShockZCandidate = allowShort and z >= shockEntryZ
bool longShockMoveCandidate = longShockZCandidate and shockDown
bool shortShockMoveCandidate = shortShockZCandidate and shockUp
bool longShockEnvironmentCandidate = longShockMoveCandidate and shockEnvironment
bool shortShockEnvironmentCandidate = shortShockMoveCandidate and shockEnvironment
bool longShockDecelerationCandidate = longShockEnvironmentCandidate and decelerationOK
bool shortShockDecelerationCandidate = shortShockEnvironmentCandidate and decelerationOK
bool longShockRejectionCandidate = longShockDecelerationCandidate and longRejectionOK
bool shortShockRejectionCandidate = shortShockDecelerationCandidate and shortRejectionOK

if allowBarCloseDecision and logic.pos == 0 and canEnter

    broker.shockZCandidates += (longShockZCandidate ? 1 : 0) + (shortShockZCandidate ? 1 : 0)
    broker.shockMoveCandidates += (longShockMoveCandidate ? 1 : 0) + (shortShockMoveCandidate ? 1 : 0)
    broker.shockEnvironmentPass += (longShockEnvironmentCandidate ? 1 : 0) + (shortShockEnvironmentCandidate ? 1 : 0)
    broker.shockDecelerationPass += (longShockDecelerationCandidate ? 1 : 0) + (shortShockDecelerationCandidate ? 1 : 0)
    broker.shockRejectionPass += (longShockRejectionCandidate ? 1 : 0) + (shortShockRejectionCandidate ? 1 : 0)

    bool noSameLong  = na(logic.setupBar) or logic.setupDir != 1
    bool noSameShort = na(logic.setupBar) or logic.setupDir != -1

    bool longShockSetup = allowLong and shockEnvironment and shockDown and z <= -shockEntryZ and decelerationOK and longRejectionOK and noSameLong
    bool shortShockSetup = allowShort and shockEnvironment and shockUp and z >= shockEntryZ and decelerationOK and shortRejectionOK and noSameShort
    bool longRangeSetup = allowLong and rangeEnvironment and z <= -rangeEntryZ and noSameLong
    bool shortRangeSetup = allowShort and rangeEnvironment and z >= rangeEntryZ and noSameShort

    if longShockSetup
        broker.shockSetups += 1
        logic.setupBar := bar_index
        logic.setupDir := 1
        logic.setupMode := 2
        logicSetupEventBar := bar_index
        logicSetupEventDir := 1
        logicSetupEventMode := 2

    else if shortShockSetup
        broker.shockSetups += 1
        logic.setupBar := bar_index
        logic.setupDir := -1
        logic.setupMode := 2
        logicSetupEventBar := bar_index
        logicSetupEventDir := -1
        logicSetupEventMode := 2

    else if longRangeSetup
        logic.setupBar := bar_index
        logic.setupDir := 1
        logic.setupMode := 1
        logicSetupEventBar := bar_index
        logicSetupEventDir := 1
        logicSetupEventMode := 1

    else if shortRangeSetup
        logic.setupBar := bar_index
        logic.setupDir := -1
        logic.setupMode := 1
        logicSetupEventBar := bar_index
        logicSetupEventDir := -1
        logicSetupEventMode := 1


// ============================================================================
// Setup Expiry
// ============================================================================

if allowBarCloseDecision and not na(logic.setupBar)
    int allowedAge = logic.setupMode == 2 ? shockSetupBars : rangeSetupBars

    if bar_index - logic.setupBar > allowedAge
        logic.setupBar := na
        logic.setupDir := 0
        logic.setupMode := 0


// ============================================================================
// Setup 提前失败 (Z 走极端)
// ============================================================================

if allowBarCloseDecision and not na(logic.setupBar) and logic.setupDir * z <= -stopZ
    logic.setupBar := na
    logic.setupDir := 0
    logic.setupMode := 0


// ============================================================================
// Entry Confirmation
// ============================================================================

float entryZ = logic.setupMode == 2 ? shockEntryZ : rangeEntryZ

bool candleOK = false

if logic.setupDir == 1
    candleOK := not requireCandleConfirm or close > close[1]
else if logic.setupDir == -1
    candleOK := not requireCandleConfirm or close < close[1]

bool zReclaim = false

if logic.setupDir == 1
    zReclaim := logic.setupMode == 2 ? zCrossOverNegShock : zCrossOverNegRange
else if logic.setupDir == -1
    zReclaim := logic.setupMode == 2 ? zCrossUnderPosShock : zCrossUnderPosRange

// requireBandReclaim 使用价格重新进入对应 Entry Z 区间的明确定义。
// zReclaim 仍是独立且必要的 Entry Confirmation 条件。
bool priceBandReclaim = false

if logic.setupDir == 1
    priceBandReclaim := close > mean15 - entryZ * safeStd
else if logic.setupDir == -1
    priceBandReclaim := close < mean15 + entryZ * safeStd

bool bandOK = not requireBandReclaim or priceBandReclaim

bool longEntrySignal = barstate.isconfirmed and logic.pos == 0 and not hardTrendVeto and logic.setupDir == 1 and not na(logic.setupBar) and zReclaim and bandOK and candleOK
bool shortEntrySignal = barstate.isconfirmed and logic.pos == 0 and not hardTrendVeto and logic.setupDir == -1 and not na(logic.setupBar) and zReclaim and bandOK and candleOK


// ============================================================================
// 活跃止损 (含 T减后保本偏移 —— 单一事实来源,管理逻辑与绘图共用)
// ============================================================================

f_logicActiveStop(int dir) =>
    float s = logic.partialTaken and moveStopToBE ? (dir == 1 ? math.max(logic.baseStop, logic.entryPrice + logic.cost) : math.min(logic.baseStop, logic.entryPrice - logic.cost)) : logic.baseStop
    s


// ============================================================================
// Alert / cost helpers
// ============================================================================

// Strategy Tester 的 commission/slippage 是 strategy() 的编译期属性。
// 该估算只用于 Broker 执行诊断;Logic BE 只使用 logic.cost。
f_brokerExecutionCost(float price) =>
    price * (2.0 * commissionBps) / 10000.0 + 2.0 * slippageTicks * syminfo.mintick

f_modeName(int mode) =>
    mode == 2 ? "Shock" : "Range"

f_directionName(int dir) =>
    dir == 1 ? "Long" : "Short"

f_orderMessage(int dir, string eventName, int mode, float price) =>
    "MR-T|direction=" + f_directionName(dir) + "|event=" + eventName + "|mode=" + f_modeName(mode) + "|price=" + str.tostring(price, format.mintick)

f_exitName(int reason) =>
    reason == R_FINAL ? "Final Exit" : reason == R_TREND ? "Trend Fail" : reason == R_TIME ? "Timeout" : reason == R_BE ? "Breakeven" : "Stop"

// ============================================================================
// V2 Logic Entry
// ============================================================================

f_logicEnter(int dir) =>
    // V2 enters the Logic State on the Entry Decision close, before any fill.
    logic.pos := dir
    logic.partialTaken := false
    logic.entryPrice := close
    logic.mean := mean15
    logic.std := safeStd
    logic.atr := safeATR
    logic.entryBar := bar_index

    bool shock = logic.setupMode == 2
    logic.tradeMode := shock ? 2 : 1

    float pz = shock ? shockPartialZ : rangePartialZ
    float ez = shock ? shockExitZ : rangeExitZ
    logic.partialTarget := logic.mean - dir * pz * logic.std
    logic.finalTarget := logic.mean - dir * ez * logic.std

    float atrStop = logic.entryPrice - dir * hardStopATR * logic.atr
    float statStop = logic.mean - dir * stopZ * logic.std
    float tightStop = dir == 1 ? math.max(atrStop, statStop) : math.min(atrStop, statStop)
    float looseStop = dir == 1 ? math.min(atrStop, statStop) : math.max(atrStop, statStop)
    float balStop = looseStop + (tightStop - looseStop) * balancedWeight

    if stopMode == "Tight"
        logic.baseStop := tightStop
    else if stopMode == "Loose"
        logic.baseStop := looseStop
    else
        logic.baseStop := balStop

    float rawTimeStop = fallbackTimeStopBars

    if not na(halfLife)
        rawTimeStop := halfLife * timeStopMultiplier

    float limitedTimeStop = math.max(minTimeStopBars, rawTimeStop)
    limitedTimeStop := math.min(maxTimeStopBars, limitedTimeStop)
    logic.timeStop := int(math.round(limitedTimeStop))

    // V2 cost semantics: round-trip commission only. Broker slippage is not
    // part of the Logic BE threshold.
    logic.cost := logic.entryPrice * (2.0 * commissionBps) / 10000.0
    logic.trimDecisionBar := na
    logic.exitDecisionBar := na

    logic.setupBar := na
    logic.setupDir := 0
    logic.setupMode := 0

    logic.eventKind := 1
    logic.eventDir := dir
    logic.eventReason := 0
    logic.logicEventBar := bar_index
    logic.logicEventKind := 1
    logic.logicEventDir := dir
    logic.logicEventReason := 0
    logic.logicEventMode := logic.tradeMode
    logic.logicEventPrice := logic.entryPrice


// ============================================================================
// V2 Logic Exit
// ============================================================================

f_logicExit(int dir, int reason) =>
    float rawPnl = (close - logic.entryPrice) * dir
    float costVal = logic.entryPrice * (2.0 * commissionBps) / 10000.0
    float pnlNet = rawPnl - costVal
    int finishedMode = logic.tradeMode

    logic.lastPnlATR := pnlNet / logic.atr
    logic.lastPnlPct := pnlNet / logic.entryPrice * 100.0
    logic.sumPnlATR += logic.lastPnlATR
    logic.tradeCount += 1

    logic.lastExitBar := bar_index
    logic.pos := 0
    logic.partialTaken := false

    logic.entryBar := na
    logic.entryPrice := na
    logic.mean := na
    logic.std := na
    logic.atr := na
    logic.partialTarget := na
    logic.finalTarget := na
    logic.baseStop := na
    logic.timeStop := na
    logic.tradeMode := 0
    logic.cost := 0.0

    logic.setupBar := na
    logic.setupDir := 0
    logic.setupMode := 0

    logic.eventKind := 3
    logic.eventDir := dir
    logic.eventReason := reason
    logic.logicEventBar := bar_index
    logic.logicEventKind := 3
    logic.logicEventDir := dir
    logic.logicEventReason := reason
    logic.logicEventMode := finishedMode
    logic.logicEventPrice := close


// ============================================================================
// V2 Logic Manage
// ============================================================================
// Exit priority is exactly V2: Stop/BE → Trend Fail → Timeout → Trim → Final.

f_logicManage(int dir) =>
    int decisionCode = MANAGE_NONE
    bool canManage = logic.pos == dir and not na(logic.entryBar) and bar_index > logic.entryBar

    if barstate.isconfirmed and canManage
        float activeStop = f_logicActiveStop(dir)
        bool stopHit = not na(activeStop) and (dir == 1 ? close <= activeStop : close >= activeStop)
        bool trendFailed = dir * htfSlopeATR <= -vetoHtfSlope or dir * localSlopeATR <= -vetoLocalSlope
        bool timeFailed = not na(logic.timeStop) and (bar_index - logic.entryBar) >= logic.timeStop
        bool partialReached = not logic.partialTaken and not na(logic.partialTarget) and (dir == 1 ? close >= logic.partialTarget : close <= logic.partialTarget)
        bool finalReached = logic.partialTaken and not na(logic.finalTarget) and (dir == 1 ? close >= logic.finalTarget : close <= logic.finalTarget)

        if stopHit
            bool isBE = logic.partialTaken and moveStopToBE
            logic.exitDecisionBar := bar_index
            if isBE
                f_logicExit(dir, R_BE)
            else
                f_logicExit(dir, R_STOP)
            decisionCode := MANAGE_STOP_BE
        else if trendFailed
            logic.exitDecisionBar := bar_index
            f_logicExit(dir, R_TREND)
            decisionCode := MANAGE_TREND
        else if timeFailed
            logic.exitDecisionBar := bar_index
            f_logicExit(dir, R_TIME)
            decisionCode := MANAGE_TIMEOUT
        else if partialReached
            logic.partialTaken := true
            logic.trimDecisionBar := bar_index
            logic.eventKind := 2
            logic.eventDir := dir
            logic.eventReason := 0
            logic.logicEventBar := bar_index
            logic.logicEventKind := 2
            logic.logicEventDir := dir
            logic.logicEventReason := 0
            logic.logicEventMode := logic.tradeMode
            logic.logicEventPrice := close
            decisionCode := MANAGE_TRIM
        else if finalReached
            logic.exitDecisionBar := bar_index
            f_logicExit(dir, R_FINAL)
            decisionCode := MANAGE_FINAL

    decisionCode


// ============================================================================
// Manage (方向参数化 · confirmed-close only)
// ============================================================================
// 所有价格水平只作为 confirmed 15m close 的决策阈值，不挂盘中 stop/limit
// 价格订单。每根正常收盘 execution 最多选择一个事件，优先级为:
// Stop/BE → Trend Fail → Timeout → Trim → Final。

// The V2 management implementation is f_logicManage() above. A Broker state
// or an order-fill transition is intentionally absent from its inputs.


// ============================================================================
// Logic Decision Execution → Broker Order Intent
// ============================================================================
// This order is the V2 order: Entry Decision, Long Manage, Short Manage.
// Broker position state is not consulted by the Logic functions.

if allowBarCloseDecision
    if longEntrySignal
        int entryMode = logic.setupMode
        f_logicEnter(1)
        broker.entryIntentPending := not consistencyRecoveryRequired
        broker.entryIntentDir := 1
        broker.entryIntentMode := entryMode
        broker.entryIntentBar := bar_index
        broker.shockConfirmedEntries += entryMode == 2 ? 1 : 0

        if not consistencyRecoveryRequired
            strategy.entry("MR-L", strategy.long, alert_message = f_orderMessage(1, "Long Entry", entryMode, close))
    else if shortEntrySignal
        int entryMode = logic.setupMode
        f_logicEnter(-1)
        broker.entryIntentPending := not consistencyRecoveryRequired
        broker.entryIntentDir := -1
        broker.entryIntentMode := entryMode
        broker.entryIntentBar := bar_index
        broker.shockConfirmedEntries += entryMode == 2 ? 1 : 0

        if not consistencyRecoveryRequired
            strategy.entry("MR-S", strategy.short, alert_message = f_orderMessage(-1, "Short Entry", entryMode, close))

    f_logicManage(1)
    f_logicManage(-1)

// Logic Trim changes partialTaken before this Broker intent is submitted.
if allowBarCloseDecision and logic.logicEventBar == bar_index and logic.logicEventKind == 2 and not broker.trimIntentPending and not consistencyRecoveryRequired
    string trimEntryId = logic.logicEventDir == 1 ? "MR-L" : "MR-S"
    broker.trimIntentPending := true
    broker.trimIntentDir := logic.logicEventDir
    broker.trimIntentMode := logic.logicEventMode
    broker.trimIntentBar := bar_index
    strategy.close(trimEntryId, comment = "Trim", qty_percent = trimPct, alert_message = f_orderMessage(logic.logicEventDir, "Trim", logic.logicEventMode, close))

// Logic full Exit is already flat before the actual Broker close is placed.
if allowBarCloseDecision and logic.logicEventBar == bar_index and logic.logicEventKind == 3 and not broker.fullExitIntentPending and not consistencyRecoveryRequired
    string closeEntryId = logic.logicEventDir == 1 ? "MR-L" : "MR-S"
    string closeEvent = f_exitName(logic.logicEventReason)
    broker.fullExitIntentPending := true
    broker.fullExitIntentDir := logic.logicEventDir
    broker.fullExitIntentMode := logic.logicEventMode
    broker.fullExitIntentReason := logic.logicEventReason
    broker.fullExitIntentBar := bar_index
    broker.trimIntentPending := false
    strategy.close(closeEntryId, comment = closeEvent, alert_message = f_orderMessage(logic.logicEventDir, closeEvent, logic.logicEventMode, close))

if logic.logicEventBar == bar_index and logic.logicEventKind == 3 and broker.fullExitIntentPending
    consistencyState := CONSISTENCY_PENDING_EXIT
else if logic.logicEventBar == bar_index and logic.logicEventKind == 2 and broker.trimIntentPending
    consistencyState := CONSISTENCY_PENDING_TRIM
else if logic.logicEventBar == bar_index and logic.logicEventKind == 1 and broker.entryIntentPending
    consistencyState := CONSISTENCY_PENDING_ENTRY
else if currentPositionSize != 0.0 and logic.pos != 0 and currentPositionDir == logic.pos
    consistencyState := currentPositionDir == 1 ? CONSISTENCY_OK_LONG : CONSISTENCY_OK_SHORT
else if currentPositionSize == 0.0 and logic.pos == 0
    consistencyState := CONSISTENCY_OK_FLAT

// Commit only Broker observations. No Logic lifecycle mutation occurs here.
broker.previousPositionSize := currentPositionSize
broker.observedClosedTrades := closedTradesNow

// Derived Logic Events → chart labels, Data Window, and alerts.
setupEvent := logicSetupEventBar == bar_index
setupEventDir := logicSetupEventDir
setupEventMode := logicSetupEventMode
entryEvent := logic.logicEventBar == bar_index and logic.logicEventKind == 1
entryEventDir := logic.logicEventDir
partialEvent := logic.logicEventBar == bar_index and logic.logicEventKind == 2
partialEventDir := logic.logicEventDir
exitEvent := logic.logicEventBar == bar_index and logic.logicEventKind == 3
exitEventDir := logic.logicEventDir
exitReason := logic.logicEventReason
int eventMode = logic.logicEventMode
float eventPrice = logic.logicEventPrice


// ============================================================================
// Plot Mean
// ============================================================================

plot(mean15, "Local Mean", color = color.yellow, linewidth = 2)


// ============================================================================
// Bands
// ============================================================================

pRangeUpper = plot(showBands ? upperRangeBand : na, "Range +Z", color = color.new(color.orange, 35))
pRangeLower = plot(showBands ? lowerRangeBand : na, "Range -Z", color = color.new(color.aqua, 35))

pShockUpper = plot(showBands ? upperShockBand : na, "Shock +Z", color = color.new(color.red, 35))
pShockLower = plot(showBands ? lowerShockBand : na, "Shock -Z", color = color.new(color.green, 35))

pStopUpper = plot(showBands ? upperStopBand : na, "Extreme +Z", color = color.new(color.red, 75))
pStopLower = plot(showBands ? lowerStopBand : na, "Extreme -Z", color = color.new(color.red, 75))

fill(pShockUpper, pStopUpper, color = color.new(color.red, 94))
fill(pShockLower, pStopLower, color = color.new(color.green, 94))


// ============================================================================
// Background
// ============================================================================

color bgCol = na

if showBackground
    if rangeEnvironment
        bgCol := color.new(color.blue, 92)
    else if shockEnvironment
        bgCol := color.new(color.purple, 94)

bgcolor(bgCol, title = "Mean Reversion Environment")


// ============================================================================
// Active Trade Lines
// ============================================================================

float activePartialLine = na
float activeFinalLine = na
float activeRiskLine = na

if logic.pos != 0
    activePartialLine := logic.partialTarget
    activeFinalLine := logic.finalTarget
    activeRiskLine := f_logicActiveStop(logic.pos)

plot(showTradeLevels ? activePartialLine : na, "T减目标 / Trim", color = color.orange, linewidth = 2, style = plot.style_linebr)
plot(showTradeLevels ? activeFinalLine : na, "T平目标 / Target", color = color.white, linewidth = 2, style = plot.style_linebr)
plot(showTradeLevels ? activeRiskLine : na, "风险线 / Risk", color = color.red, linewidth = 2, style = plot.style_linebr)


// ============================================================================
// Setup Labels
// ============================================================================
// 用 label.new 而非 plotshape:plotshape 的 text 是 const string,无法随
// lang 切换;label.new 的 text 是 series string,可接 f_tr()。

if showSetup and setupEvent and setupEventMode == 1 and setupEventDir == 1
    label.new(bar_index, low, f_tr("R观察", "R obs"), style = label.style_label_up, color = color.new(color.green, 55), textcolor = color.white, size = size.tiny)

if showSetup and setupEvent and setupEventMode == 1 and setupEventDir == -1
    label.new(bar_index, high, f_tr("R观察", "R obs"), style = label.style_label_down, color = color.new(color.red, 55), textcolor = color.white, size = size.tiny)

if showSetup and setupEvent and setupEventMode == 2 and setupEventDir == 1
    label.new(bar_index, low, f_tr("S观察", "S obs"), style = label.style_label_up, color = color.green, textcolor = color.white, size = size.tiny)

if showSetup and setupEvent and setupEventMode == 2 and setupEventDir == -1
    label.new(bar_index, high, f_tr("S观察", "S obs"), style = label.style_label_down, color = color.red, textcolor = color.white, size = size.tiny)


// ============================================================================
// Entry
// ============================================================================

if entryEvent and entryEventDir == 1
    label.new(bar_index, low, f_tr("T买", "T Long"), style = label.style_label_up, color = color.green, textcolor = color.white, size = size.small)

if entryEvent and entryEventDir == -1
    label.new(bar_index, high, f_tr("T空", "T Short"), style = label.style_label_down, color = color.red, textcolor = color.white, size = size.small)


// ============================================================================
// Partial
// ============================================================================

if partialEvent and partialEventDir == 1
    label.new(bar_index, high, f_tr("T减", "T Trim"), style = label.style_label_down, color = color.orange, textcolor = color.white, size = size.tiny)

if partialEvent and partialEventDir == -1
    label.new(bar_index, low, f_tr("T减", "T Trim"), style = label.style_label_up, color = color.aqua, textcolor = color.black, size = size.tiny)


// ============================================================================
// Exits (Final / Stop / Trend / Time / BE)
// ============================================================================

if exitEvent and exitReason == R_FINAL and exitEventDir == 1
    label.new(bar_index, high, f_tr("T平", "T Close"), style = label.style_label_down, color = color.lime, textcolor = color.black, size = size.small)

if exitEvent and exitReason == R_FINAL and exitEventDir == -1
    label.new(bar_index, low, f_tr("T平", "T Close"), style = label.style_label_up, color = color.lime, textcolor = color.black, size = size.small)

if exitEvent and exitReason == R_STOP and exitEventDir == 1
    label.new(bar_index, high, f_tr("T止损", "T Stop"), style = label.style_label_down, color = color.red, textcolor = color.white, size = size.small)

if exitEvent and exitReason == R_STOP and exitEventDir == -1
    label.new(bar_index, low, f_tr("T止损", "T Stop"), style = label.style_label_up, color = color.red, textcolor = color.white, size = size.small)

if exitEvent and exitReason == R_TREND and exitEventDir == 1
    label.new(bar_index, high, f_tr("趋势失效", "Trend fail"), style = label.style_label_down, color = color.purple, textcolor = color.white, size = size.small)

if exitEvent and exitReason == R_TREND and exitEventDir == -1
    label.new(bar_index, low, f_tr("趋势失效", "Trend fail"), style = label.style_label_up, color = color.purple, textcolor = color.white, size = size.small)

if exitEvent and exitReason == R_TIME and exitEventDir == 1
    label.new(bar_index, high, f_tr("T超时", "T Timeout"), style = label.style_label_down, color = color.gray, textcolor = color.white, size = size.small)

if exitEvent and exitReason == R_TIME and exitEventDir == -1
    label.new(bar_index, low, f_tr("T超时", "T Timeout"), style = label.style_label_up, color = color.gray, textcolor = color.white, size = size.small)

if exitEvent and exitReason == R_BE and exitEventDir == 1
    label.new(bar_index, high, f_tr("T保本", "T BE"), style = label.style_label_down, color = color.gray, textcolor = color.white, size = size.tiny)

if exitEvent and exitReason == R_BE and exitEventDir == -1
    label.new(bar_index, low, f_tr("T保本", "T BE"), style = label.style_label_up, color = color.gray, textcolor = color.white, size = size.tiny)


// ============================================================================
// Data Window
// ============================================================================
// Keep long-lived market, Logic, Broker, and funnel parity fields here. Current
// UI-only execution state remains in the Panel so it does not consume plot budget.

plot(z, "Z-score", display = display.data_window)
plot(regimeScore, "Regime Score", display = display.data_window)
plot(halfLife, "Half-Life", display = display.data_window)
plot(shockMove, "Shock ATR", display = display.data_window)
plot(previousShockMove, "Previous Shock ATR", display = display.data_window)
plot(localER, "15m ER", display = display.data_window)
plot(htfER, "1H ER", display = display.data_window)
plot(localSlopeATR, "15m Slope", display = display.data_window)
plot(htfSlopeATR, "1H Slope", display = display.data_window)
plot(logic.pos, "Logic Position", display = display.data_window)
plot(logic.partialTaken ? 1 : 0, "Logic Partial Taken", display = display.data_window)
plot(logic.entryBar, "Logic Entry Bar", display = display.data_window)
plot(logic.entryPrice, "Logic Entry Price", display = display.data_window)
plot(logic.partialTarget, "Logic Partial Target", display = display.data_window)
plot(logic.finalTarget, "Logic Final Target", display = display.data_window)
plot(logic.pos != 0 ? f_logicActiveStop(logic.pos) : na, "Logic Active Stop", display = display.data_window)
plot(logic.timeStop, "Logic Time Stop", display = display.data_window)
plot(logic.lastExitBar, "Logic Last Exit Bar", display = display.data_window)
plot(logic.logicEventKind, "Logic Event Code", display = display.data_window)
plot(logic.logicEventReason, "Logic Event Reason", display = display.data_window)
plot(currentPositionSize, "Broker Position", display = display.data_window)
plot(broker.brokerEntryPrice, "Broker Entry Price", display = display.data_window)
plot(broker.fillEventKind, "Broker Fill Event", display = display.data_window)
plot(broker.recoveryCount, "Broker Recovery Count", display = display.data_window)
plot(consistencyState, "Broker Consistency State", display = display.data_window)
plot(broker.entryFillBar, "Broker Entry Fill Bar", display = display.data_window)
plot(logic.trimDecisionBar, "Logic Trim Decision Bar", display = display.data_window)
plot(broker.trimFillBar, "Broker Trim Fill Bar", display = display.data_window)
plot(logic.exitDecisionBar, "Logic Exit Decision Bar", display = display.data_window)
plot(broker.fullExitFillBar, "Broker Full Exit Fill Bar", display = display.data_window)
plot(broker.rangeEntries, "Range Entries", display = display.data_window)
plot(broker.rangeClosed, "Range Closed", display = display.data_window)
plot(broker.rangeWins, "Range Wins", display = display.data_window)
plot(broker.shockEntries, "Shock Entries", display = display.data_window)
plot(broker.shockClosed, "Shock Closed", display = display.data_window)
plot(broker.shockWins, "Shock Wins", display = display.data_window)
plot(broker.latestClosedExitCode, "Latest Closed Entry ID Code", display = display.data_window)
plot(broker.shockZCandidates, "Shock Z Candidates", display = display.data_window)
plot(broker.shockMoveCandidates, "Shock Move Candidates", display = display.data_window)
plot(broker.shockEnvironmentPass, "Shock Environment Pass", display = display.data_window)
plot(broker.shockDecelerationPass, "Shock Deceleration Pass", display = display.data_window)
plot(broker.shockRejectionPass, "Shock Rejection Pass", display = display.data_window)
plot(broker.shockSetups, "Shock Setups", display = display.data_window)
plot(broker.shockConfirmedEntries, "Shock Confirmed Entries", display = display.data_window)


// ============================================================================
// Panel
// ============================================================================

var table panel = table.new(position.top_right, 2, 22, border_width = 1)

if showPanel and barstate.islast

    string envText = f_tr("禁做T", "No T")
    color envColor = color.gray

    if rangeEnvironment
        envText := "Range"
        envColor := color.aqua
    else if shockEnvironment
        envText := "Shock Only"
        envColor := color.purple

    bool consistencyError = consistencyState >= CONSISTENCY_STALE_ACTIVE_FLAT and consistencyState <= CONSISTENCY_INVALID_CONTEXT
    string stateText = consistencyError ? f_tr("状态错误", "STATE ERROR") : logic.pos == 1 ? f_tr("逻辑T多", "Logic Long") : logic.pos == -1 ? f_tr("逻辑T空", "Logic Short") : broker.entryIntentPending and broker.entryIntentDir == 1 ? f_tr("待多头成交", "Pending Long") : broker.entryIntentPending and broker.entryIntentDir == -1 ? f_tr("待空头成交", "Pending Short") : f_tr("逻辑空仓", "Logic Flat")

    string brokerPositionText = currentPositionSize == 0.0 ? f_tr("空仓", "Flat") : currentPositionDir == 1 ? f_tr("多头 ", "Long ") + str.tostring(math.abs(currentPositionSize), "#.########") : f_tr("空头 ", "Short ") + str.tostring(math.abs(currentPositionSize), "#.########")
    string brokerAvgText = currentPositionSize == 0.0 ? "-" : str.tostring(strategy.position_avg_price, format.mintick)
    string brokerStateText = broker.fullExitIntentPending ? f_tr("等待全平成交", "Full exit pending") : broker.trimIntentPending ? f_tr("等待T减成交", "Trim pending") : broker.entryIntentPending ? f_tr("等待进场成交", "Entry pending") : currentPositionSize != 0.0 ? f_tr("已成交", "Filled") : f_tr("空仓", "Flat")
    string consistencyText = f_consistencyName(consistencyState)
    color consistencyColor = consistencyError ? color.red : color.lime

    string setupText = f_tr("无", "None")

    if logic.setupMode == 1 and logic.setupDir == 1
        setupText := f_tr("R等T买", "Range→Long")
    else if logic.setupMode == 2 and logic.setupDir == 1
        setupText := f_tr("S等T买", "Shock→Long")
    else if logic.setupMode == 1 and logic.setupDir == -1
        setupText := f_tr("R等T空", "Range→Short")
    else if logic.setupMode == 2 and logic.setupDir == -1
        setupText := f_tr("S等T空", "Shock→Short")

    string hlText = na(halfLife) ? f_tr("无效", "n/a") : str.tostring(halfLife, "#.0")
    string shockText = str.tostring(shockMove, "#.00") + " ATR"
    string scoreText = str.tostring(regimeScore, "#")
    string modeText = logic.pos != 0 ? f_modeName(logic.tradeMode) : broker.entryIntentPending ? f_modeName(broker.entryIntentMode) : "-"
    string stopText = stopMode
    string phaseText = logic.pos != 0 ? logic.partialTaken ? f_tr("T减后", "Final phase") : f_tr("等待T减", "Trim phase") : broker.fullExitIntentPending ? f_tr("等待全平成交", "Full exit pending") : broker.trimIntentPending ? f_tr("等待T减成交", "Trim fill pending") : broker.entryIntentPending ? f_tr("等待进场成交", "Entry pending") : "-"
    string entryText = logic.pos == 0 ? "-" : str.tostring(logic.entryPrice, format.mintick) + " / " + str.tostring(broker.brokerEntryPrice, format.mintick)
    string trimText = logic.pos == 0 ? "-" : str.tostring(logic.partialTarget, format.mintick)
    string finalText = logic.pos == 0 ? "-" : str.tostring(logic.finalTarget, format.mintick)
    string riskText = logic.pos == 0 ? "-" : str.tostring(f_logicActiveStop(logic.pos), format.mintick)
    float testerProfitFactor = strategy.grossloss != 0.0 ? strategy.grossprofit / math.abs(strategy.grossloss) : na
    string testerPLText = str.tostring(strategy.netprofit, format.mintick) + " / DD " + str.tostring(strategy.max_drawdown, format.mintick) + " / PF " + (na(testerProfitFactor) ? "-" : str.tostring(testerProfitFactor, "#.00"))
    float testerWinRate = strategy.closedtrades > 0 ? strategy.wintrades / strategy.closedtrades * 100.0 : na
    string testerTradeText = str.tostring(strategy.closedtrades, "#") + " / " + (na(testerWinRate) ? "-" : str.tostring(testerWinRate, "#.0") + "%")
    float brokerExecutionCost = currentPositionSize == 0.0 ? na : f_brokerExecutionCost(strategy.position_avg_price)
    string brokerCostText = na(brokerExecutionCost) ? "-" : str.tostring(brokerExecutionCost, format.mintick)
    float rangeWinRate = broker.rangeClosed > 0 ? broker.rangeWins / broker.rangeClosed * 100.0 : na
    float shockWinRate = broker.shockClosed > 0 ? broker.shockWins / broker.shockClosed * 100.0 : na
    string rangeStatsText = "E " + str.tostring(broker.rangeEntries, "#") + " / C " + str.tostring(broker.rangeClosed, "#") + " / W " + str.tostring(broker.rangeWins, "#") + " (" + (na(rangeWinRate) ? "-" : str.tostring(rangeWinRate, "#.0") + "%") + ")"
    string shockStatsText = "E " + str.tostring(broker.shockEntries, "#") + " / C " + str.tostring(broker.shockClosed, "#") + " / W " + str.tostring(broker.shockWins, "#") + " (" + (na(shockWinRate) ? "-" : str.tostring(shockWinRate, "#.0") + "%") + ")"

    table.cell(panel, 0, 0, SCRIPT_NAME + " v" + SCRIPT_VERSION)
    table.cell(panel, 1, 0, "15m")

    table.cell(panel, 0, 1, f_tr("环境", "Env"))
    table.cell(panel, 1, 1, envText, text_color = envColor)

    table.cell(panel, 0, 2, "Score")
    table.cell(panel, 1, 2, scoreText)

    table.cell(panel, 0, 3, f_tr("状态", "State"))
    table.cell(panel, 1, 3, stateText)

    table.cell(panel, 0, 4, "Setup")
    table.cell(panel, 1, 4, setupText)

    table.cell(panel, 0, 5, "Z")
    table.cell(panel, 1, 5, str.tostring(z, "#.00"))

    table.cell(panel, 0, 6, "Shock")
    table.cell(panel, 1, 6, shockText)

    table.cell(panel, 0, 7, "Half-Life")
    table.cell(panel, 1, 7, hlText)

    table.cell(panel, 0, 8, f_tr("模式", "Mode"))
    table.cell(panel, 1, 8, modeText)

    table.cell(panel, 0, 9, f_tr("阶段", "Phase"))
    table.cell(panel, 1, 9, phaseText)

    table.cell(panel, 0, 10, f_tr("逻辑/成交入场价", "Logic / Broker entry"))
    table.cell(panel, 1, 10, entryText)

    table.cell(panel, 0, 11, f_tr("T减 / T平", "Trim / Final"))
    table.cell(panel, 1, 11, trimText + " / " + finalText)

    table.cell(panel, 0, 12, "Risk")
    table.cell(panel, 1, 12, riskText + " (" + stopText + ")")

    table.cell(panel, 0, 13, f_tr("Tester 净利/回撤/PF", "Tester P&L/DD/PF"))
    table.cell(panel, 1, 13, testerPLText)

    table.cell(panel, 0, 14, f_tr("Tester 交易 / 胜率", "Tester trades / win"))
    table.cell(panel, 1, 14, testerTradeText)

    table.cell(panel, 0, 15, f_tr("Range 进场 / 已平 / 盈利", "Range entries / closed / wins"))
    table.cell(panel, 1, 15, rangeStatsText)

    table.cell(panel, 0, 16, f_tr("Shock 进场 / 已平 / 盈利", "Shock entries / closed / wins"))
    table.cell(panel, 1, 16, shockStatsText)

    table.cell(panel, 0, 17, f_tr("Broker 仓位", "Broker Position"))
    table.cell(panel, 1, 17, brokerPositionText)

    table.cell(panel, 0, 18, f_tr("Broker 均价", "Broker Avg Price"))
    table.cell(panel, 1, 18, brokerAvgText)

    table.cell(panel, 0, 19, f_tr("Broker状态", "Broker State"))
    table.cell(panel, 1, 19, brokerStateText)

    table.cell(panel, 0, 20, f_tr("一致性", "Consistency"))
    table.cell(panel, 1, 20, consistencyText, text_color = consistencyColor)

    table.cell(panel, 0, 21, f_tr("Broker成本估算", "Broker cost estimate"))
    table.cell(panel, 1, 21, brokerCostText)


if not showPanel and barstate.islast
    table.clear(panel, 0, 0, 1, 21)


// ============================================================================
// Alerts
// ============================================================================

if setupEvent and allowBarCloseDecision
    string setupEventName = setupEventMode == 2 ? "Shock Setup" : "Range Setup"
    alert(f_orderMessage(setupEventDir, setupEventName, setupEventMode, close), alert.freq_all)

if entryEvent and allowBarCloseDecision
    alert(f_orderMessage(entryEventDir, "Entry Decision", eventMode, eventPrice), alert.freq_all)

if partialEvent and allowBarCloseDecision
    alert(f_orderMessage(partialEventDir, "Trim", eventMode, eventPrice), alert.freq_all)

    if moveStopToBE
        alert(f_orderMessage(partialEventDir, "Breakeven Armed", eventMode, eventPrice), alert.freq_all)

if exitEvent and allowBarCloseDecision
    alert(f_orderMessage(exitEventDir, f_exitName(exitReason), eventMode, eventPrice), alert.freq_all)
